---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  BUSINESS,
  CLARITY_PROJECT_ID,
  GA_MEASUREMENT_ID,
  GOOGLE_ADS_ID,
  SITE_ORIGIN,
} from '../config/site';
import logo from '../assets/images/logo.png';

interface Props {
  title: string;
  description: string;
  /** Path without origin, e.g. "/fleet". */
  path: string;
  /** Present when this page has its own quote form. */
  bookingHref?: string;
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
  /** "article" on a guide; everything else is a page of the site itself. */
  ogType?: 'website' | 'article';
  /**
   * Share image, as a site-root path (the `.src` of an imported asset is
   * exactly that). Resolved to an absolute URL here, because Open Graph
   * consumers do not resolve relative ones.
  */
  ogImage?: string;
  /** Describes the social image when one is supplied. */
  ogImageAlt?: string;
  /**
   * Extra structured data nodes for this page — an Article on a guide, and
   * anything else a page can honestly claim. They are emitted as their own
   * `application/ld+json` blocks alongside the site-wide LocalBusiness.
   */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  bookingHref,
  noindex = false,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  jsonLd = [],
} = Astro.props;
const canonical = new URL(path, SITE_ORIGIN).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE_ORIGIN).href : undefined;
const logoUrl = new URL(logo.src, SITE_ORIGIN).href;

const { address, geo, hours, phone } = BUSINESS;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_ORIGIN}/#business`,
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  url: SITE_ORIGIN,
  logo: logoUrl,
  telephone: phone.e164,
  email: BUSINESS.email,
  description:
    'Chicago charter bus rental and group transportation with professional drivers for local, suburban and out-of-state corporate, school, wedding, sporting event and youth group trips.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: address.street,
    addressLocality: address.city,
    addressRegion: address.region,
    postalCode: address.postalCode,
    addressCountry: address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: geo.latitude,
    longitude: geo.longitude,
  },
  hasMap: BUSINESS.googleMapsUrl,
  sameAs: [BUSINESS.googleMapsUrl],
  areaServed: [
    { '@type': 'City', name: 'Chicago' },
    { '@type': 'AdministrativeArea', name: 'Chicago metropolitan area' },
  ],
  // Office hours only. Charters run outside these hours, but "we will drive at
  // 4am" is not an opening hour and must not be modelled as one.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: hours.schemaOpens,
      closes: hours.schemaCloses,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Cropped from the real logo mark, not a substitute glyph. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d5637" />
    {/* Google tag (gtag.js) — GA4. `is:inline` keeps Astro from bundling it. */}
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    {/*
      `define:vars` wraps the body in an IIFE, so a bare `function gtag()` here
      would be scoped to it and every later caller — the conversion page below
      the fold, most of all — would get `gtag is not defined`. The stub is put
      on `window` deliberately, and the conditional keeps a second parse from
      replacing a queue that already has entries in it.
    */}
    <script is:inline define:vars={{ GA_MEASUREMENT_ID, GOOGLE_ADS_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
      gtag('config', GOOGLE_ADS_ID);
    </script>
    {/* Microsoft Clarity — session recording and heatmaps. */}
    <script is:inline define:vars={{ CLARITY_PROJECT_ID }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', CLARITY_PROJECT_ID);
    </script>
    {/*
      `<script type="application/ld+json" set:html={...}>` is the idiom, and the
      distinction matters: this shipped for months as `<set:html value={...} />`,
      which Astro rendered as a literal `<set :html="...">` element carrying an
      HTML-escaped string. The business's structured data was in the source and
      in no crawler's index. Never hand-build a script tag as a string.
    */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      jsonLd.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </head>
  <body>
    <!--
      DIRECTION CONTRACT — seed fbddba33
      THESIS: A charter company is a wayfinding system with wheels. This site is built as
      Chicago's public-way signage program, refusing the category's highway-photo hero with a
      quote bar floating over it.
      OWN-WORLD: Porcelain enamel blades in deep green over concrete, Highway Gothic in signal
      white, a sheared-bar texture drawn from the logo on both grounds, near-square 3px plate
      corners, and high-vis amber reserved exclusively for action.
      STORY: An organizer with a date, a headcount and a route learns which of the four real
      vehicles fits, trusts the drivers, and requests a quote.
      FIRST VIEWPORT: A concrete band — mono grid coordinate rule, one oversized gothic line in
      enamel, the mark's gradient as a rule beneath it, amber action; the operator's own coach
      covering the band and masked back into the concrete, carrying the proof.
      FORM: Public Way, candidate 5 of the ordered grounded list, seed key fbddba33.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review,
      the verdict, and DESIGN.md
      AMENDED: the fleet is four vehicles, 13 to 57 passengers, supplied by the owner on
      7 Aug 2026 — the single-coach framing that preceded it was a placeholder for an unanswered
      question, not a position; the honeycomb sheeting was replaced by the logo-derived
      sheared-bar texture; the hero's capacity plate was removed, leaving the photograph to
      carry the proof (the numeral is still set at scale in the fleet grid and on /fleet, where
      it also stands in for the three vehicles nobody has photographed); and the hero moved from an
      enamel band with a scrimmed photograph to a concrete band whose photograph covers it
      entirely and is masked back into the ground, sharing that ground with the quote form and
      carrying no border between them. Seed unchanged.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <Header bookingHref={bookingHref} />
    <main id="main">
      <slot />
    </main>
    <Footer bookingHref={bookingHref} />
  </body>
</html>
