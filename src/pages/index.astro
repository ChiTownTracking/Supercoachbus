---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import QuickQuote from '../components/QuickQuote.astro';
import Testimonials from '../components/Testimonials.astro';
import GuideCard from '../components/GuideCard.astro';
import CloseBand from '../components/CloseBand.astro';
import { BUSINESS, TRUST_CLAIMS } from '../config/site';
import { FLEET, MAX_SINGLE_VEHICLE, vehicleHref } from '../data/fleet';
import { SERVICES } from '../data/services';
import { GUIDES } from '../data/guides';

import heroCoach from '../assets/images/hero-caoch-bus.png';
import coachExterior from '../assets/images/coach-exterior.jpg';
import coachBus44 from '../assets/images/coach-bus-44.png';
import coachBus28 from '../assets/images/coach-bus-28.png';
import executiveSprinter from '../assets/images/excutive-sprinter.png';
import svcCorporate from '../assets/images/svc-corporate.jpg';
import svcSchool from '../assets/images/svc-school.jpg';
import svcSporting from '../assets/images/svc-sporting-events.jpg';
import svcYouth from '../assets/images/svc-youth-groups.jpg';
import trolleyCoach from '../assets/images/trolley-coach.png';

/**
 * Four of these were recovered from the live site; the wedding row is the
 * owner's own later supply. It is the one row that shows vehicles rather than
 * passengers — see the note on the fleet question in PRODUCT.md.
 */
const SERVICE_IMAGES: Record<string, { src: ImageMetadata; alt: string }> = {
  corporate: { src: svcCorporate, alt: 'A business traveller in a suit at a city office building' },
  school: { src: svcSchool, alt: 'A school group on a museum field trip with their teachers' },
  'sporting-events': { src: svcSporting, alt: 'Spectators watching a ballgame from the stands at Wrigley Field' },
  weddings: { src: trolleyCoach, alt: 'A white coach bus and a white trolley parked side by side outside a wedding venue' },
  'youth-groups': { src: svcYouth, alt: 'A youth group on an outing at a park' },
};

/** The bottom of the range the fleet covers, read off the data rather than typed. */
const SMALLEST = Math.min(...FLEET.map((v) => v.seatsMin));

/**
 * Fleet card photography, keyed by slug. All four are the operator's own,
 * supplied by the owner.
 *
 * Still keyed rather than held on the vehicle record, and the card still draws
 * the capacity into the same frame for a slug that is missing here: a fifth
 * vehicle can arrive before its photograph does, and the answer to that is a
 * drawn panel, never another vehicle's photograph.
 */
const FLEET_PHOTOS: Record<string, { src: ImageMetadata; alt: string }> = {
  supercoach: {
    src: coachExterior,
    alt: 'The Supercoach bus parked with its luggage bays open',
  },
  coach: {
    src: coachBus44,
    alt: 'The Coach Bus, a white full-length coach, seen from the front and side',
  },
  'small-coach': {
    src: coachBus28,
    alt: 'The Small Coach Bus, a white short coach, seen from the front and side',
  },
  'executive-sprinter': {
    src: executiveSprinter,
    alt: 'The Executive Sprinter Van, a black high-roof Mercedes-Benz Sprinter, seen from the front and side',
  },
};
---

<Layout
  path="/"
  title="Shuttle Bus Service | Charter Bus Service in Chicago IL"
  description="Chicago Super Coach — charter bus rental for group transportation. Get a free quote on a coach bus or Sprinter van for 13 to 57 passengers, with licensed, insured drivers. Call 630-624-3448."
>
  <!-- Thesis viewport: the coach carries the proof, the offer runs in one line
       beside it, and the action is in high-vis. The photograph is the ground of
       the whole band; the copy comes first in source and the photograph last,
       so a screen reader reaches the offer before the description of it. -->
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__lead">
        <p class="coordinate hero__coord">
          <Icon name="pin" size={15} class="hero__ico" />
          {BUSINESS.address.gridCoordinate} · Chicago, Illinois
        </p>
        <h1 class="display hero__head">Your whole group, one arrival time.</h1>
        <span class="hero__rule" aria-hidden="true"></span>
        <p class="lede hero__lede">
          Charter bus rental with professional drivers, across{' '}
          {BUSINESS.serviceArea}. Tell us the date, the headcount and the route —
          we will confirm the coach and what it costs.
        </p>
        <div class="hero__actions">
          <a class="action" href="#quote-form">
            Get a quote
            <Icon name="arrow" size={16} />
          </a>
          <a class="action action--outline" href={BUSINESS.phone.href}>
            <Icon name="phone" size={16} />
            {BUSINESS.phone.display}
          </a>
        </div>
        <p class="hero__hours mono">
          <Icon name="clock" size={15} class="hero__ico" />
          Office {BUSINESS.hours.officeSummary}
          <span class="hero__bar" aria-hidden="true"></span>
          <em>{BUSINESS.hours.charterNote}</em>
        </p>
      </div>
    </div>

    <!-- A portrait box cropping a 2.33:1 frame renders it far wider than the
         viewport, so `sizes="100vw"` would hand a phone a source it then has to
         upscale. It sits under a 90% wash there, where softness does not read —
         200vw buys back most of the detail without the full-size file. -->
    <div class="hero__media">
      <Image
        src={heroCoach}
        alt="The Chicago Super Coach executive coach bus parked with its luggage bays open, the Chicago skyline across the water behind it"
        widths={[720, 1100, 1600, 1916]}
        sizes="(min-width: 64rem) 100vw, 200vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <QuickQuote />

  <!-- Fleet. Directly under the form, because the question the form raises —
       "will my group fit?" — is answered here and nowhere earlier.
       Drawn rather than photographed: there is one real photograph in this
       building and there are four vehicles, and a fleet grid where one card is a
       coach and three are hatched boxes is worse than a fleet grid that leads
       with the number. The bar under each numeral is the same capacity to scale,
       so the four read as a fleet instead of four repeats. -->
  <section class="section fleet" id="fleet">
    <div class="shell">
      <p class="coordinate coordinate--ink fleet__coord">
        {SMALLEST}–{MAX_SINGLE_VEHICLE} passengers
      </p>
      <h2 class="title fleet__head">Four sizes, so the group fits the vehicle.</h2>
      <p class="lede measure fleet__lede">
        We are not a broker reselling somebody else's bus. This is the vehicle
        you are quoted and the vehicle that turns up.
      </p>

      <ul class="fleet__grid">
        {
          FLEET.map((v) => {
            const photo = FLEET_PHOTOS[v.slug];
            return (
              <li>
                <a class="vcard" href={vehicleHref(v)}>
                  <span class="vcard__frame">
                    {photo ? (
                      <Image
                        src={photo.src}
                        alt={photo.alt}
                        widths={[300, 480, 720]}
                        sizes="(min-width: 80rem) 18rem, (min-width: 46rem) 44vw, 92vw"
                      />
                    ) : (
                      <span class="vcard__drawn">
                        <span class="vcard__num">{v.capacityLabel}</span>
                        <span class="vcard__unit mono">Passengers</span>
                      </span>
                    )}
                  </span>

                  {/* Capacity as length, against the same ceiling for all four,
                      so the row reads as a fleet to scale. */}
                  <span
                    class="vcard__scale"
                    style={`--of:${Math.round((v.seatsMax / MAX_SINGLE_VEHICLE) * 100)}%`}
                    aria-hidden="true"
                  />

                  <span class="vcard__cap mono">
                    <b class="vcard__capnum">{v.capacityLabel}</b> Passengers
                  </span>
                  <span class="vcard__name gothic">{v.name}</span>
                  <span class="vcard__role">{v.role}</span>
                  <span class="vcard__more direction">
                    View details
                    <Icon name="arrow" size={15} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Trust: the answers a school district and a corporate buyer both ask for. -->
  <section class="section--tight trust">
    <div class="shell">
      <ul class="trust__list">
        {
          TRUST_CLAIMS.map((c) => (
            <li class="trust__item">
              <Icon name="check" size={16} />
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services: each row carries its own photograph. -->
  <section class="section field services">
    <div class="shell">
      <h2 class="title services__head">Five things we are booked for</h2>

      <ul class="services__list">
        {
          SERVICES.map((s) => {
            const img = SERVICE_IMAGES[s.slug];
            return (
              <li>
                <a class="dest" href={`/services/${s.slug}`}>
                  <figure class="dest__shot">
                    <Image src={img.src} alt={img.alt} widths={[280, 460]} sizes="(min-width: 52rem) 17rem, 92vw" />
                  </figure>
                  <span class="dest__text">
                    <span class="dest__to mono">{s.destination}</span>
                    <span class="dest__name gothic">{s.name}</span>
                    <span class="dest__prop">{s.proposition}</span>
                  </span>
                  <Icon name="arrow" size={18} class="dest__arrow" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <Testimonials />

  <!-- Guides. Held tight, and separated from the reviews by a hairline rather
       than a ground change: two concrete bands in a row need a rule between
       them, and this page has no room for another green one before the close. -->
  <section class="section--tight guides">
    <div class="shell">
      <p class="coordinate coordinate--ink">Trip planning</p>
      <h2 class="title guides__head">A little planning goes a long way.</h2>
      <p class="lede measure guides__lede">
        Straightforward guides to help you choose the right vehicle, understand
        pricing, and know when to book.
      </p>

      <ul class="guides__grid">
        {
          GUIDES.map((guide) => (
            <li>
              <GuideCard guide={guide} sizes="(min-width: 64rem) 22rem, (min-width: 44rem) 44vw, 88vw" />
            </li>
          ))
        }
      </ul>

      <a class="guides__all" href="/guides">
        View all guides
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </section>

  <CloseBand />
</Layout>

<style>
  /* ---- Hero ----
     The photograph covers the whole band and is masked back into the ground,
     rather than laid over the band with a wash on top. Same result where the
     coach is, but where the type sits it is flat concrete in the same colour the
     quote form stands on, with no border between them — one sheet with a coach
     coming up out of it.
     The band paints that colour itself rather than letting the body's ground
     through, which is what holds the pattern out of the hero: the photograph is
     the texture here, and a repeating pattern under a dissolving photo edge
     reads as dirt on the lens. */
  .hero {
    /* The mask ramp, in ascending opacity. Only the alpha of a mask stop is
       read, so `currentColor` stands in for "fully opaque" and color-mix
       supplies the fractions — no colour literal enters the ramp, and none of
       these can drift from a palette entry because none of them names one. */
    /* Every step is set by measurement, not by eye: the ramp came down when the
       ground moved from `paper-lift` to the darker `paper`, and back up when the
       pattern came out from under it. Retune it the same way — sample the band
       with the copy hidden and read the worst pixel under each line. */
    --ramp-1: color-mix(in srgb, currentColor 5%, transparent);
    --ramp-2: color-mix(in srgb, currentColor 11%, transparent);
    --ramp-3: color-mix(in srgb, currentColor 18%, transparent);
    --ramp-4: color-mix(in srgb, currentColor 48%, transparent);

    /* Narrow: the copy fills the box, so the photograph stays faint everywhere.
       It comes up only as far as the last line of type will carry — past the
       buttons the coach surfaces out of the paper instead of sitting under a
       flat sheet of it. */
    --ramp: linear-gradient(
      180deg,
      var(--ramp-1) 0%,
      var(--ramp-2) 58%,
      var(--ramp-3) 100%
    );

    --ramp-foot: linear-gradient(
      180deg,
      currentColor 0%,
      currentColor 84%,
      transparent 100%
    );

    position: relative;
    isolation: isolate;
    padding-block: var(--space-12);
    background-color: var(--paper);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
  }

  /* Queried by the hours divider below. */
  .hero__lead {
    container-type: inline-size;
  }

  .hero__coord {
    margin-bottom: var(--space-5);
    color: var(--enamel-ink);
  }

  .hero__ico {
    flex: none;
    color: var(--enamel-ink);
  }

  .hero__head {
    /* Narrower than the base display step so the line holds beside the
       photograph instead of running under it. "Your whole group," needs roughly
       8× its own font size to keep one line. */
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    color: var(--enamel-ink);
  }

  /* The mark's own gradient, and the only place it appears outside the logo. It
     is a brand rule, not an underline: it sits between the claim and the
     explanation and carries no text of its own. */
  .hero__rule {
    display: block;
    width: 11rem;
    max-width: 40%;
    height: 4px;
    margin: var(--space-6) 0;
    background: linear-gradient(
      90deg,
      var(--brand-navy),
      var(--brand-teal),
      var(--brand-green)
    );
  }

  .hero__lede {
    max-width: 46ch;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero__hours {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .hero__hours em {
    font-style: normal;
    font-weight: 700;
    color: var(--enamel-ink);
  }

  /* A scribed divider rather than a middot: the two halves of the hours truth
     are separate statements, not a list. Drawn from the line's own colour at low
     opacity, the way the coordinate rule is — the hairline token was tuned for
     flat paper and vanishes over a washed photograph. */
  .hero__bar {
    width: 1px;
    height: 1.1em;
    background: currentColor;
    opacity: 0.4;
  }

  /* Once the line wraps the divider is stranded at the end of the first row,
     dividing nothing. The wrap itself separates the two statements.
     Asked of the copy column rather than the viewport, because the column is
     what the line has to fit inside — a viewport rule got this right on a phone
     and stranded the divider again at 1024, where the column is capped to half
     the band and the hours line is 8px too long for it. */
  @container (max-width: 35rem) {
    .hero__bar {
      display: none;
    }
  }

  /* ---- The photograph ----
     Covers the band edge to edge at every width. It is 2.33:1 against a box
     that is never that wide, so `cover` always crops: on a narrow screen only
     about a fifth of the frame fits, and the crop is pulled to the cab so what
     survives still reads as a coach. */

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* The band carries no bottom border any more, so the photograph must not
       stop at one. Its last sixth dissolves into the ground, below the coach's
       wheels, and the coach reads as standing on the page rather than being cut
       off by the edge of it. Applied to the wrapper rather than composited onto
       the image's own mask, because two single-layer masks multiply the same way
       and need no `mask-composite` — which fails open, not closed, if a browser
       misses it. */
    -webkit-mask-image: var(--ramp-foot);
    mask-image: var(--ramp-foot);
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Held near the front. A portrait box takes about a quarter of this frame,
       and a quarter taken from the middle is white flank — from here it is
       windshield, mirror, headlight and grille, which still reads as a coach. */
    object-position: 90% 50%;
    -webkit-mask-image: var(--ramp);
    mask-image: var(--ramp);
  }

  @media (min-width: 64rem) {
    /* Held to half the band so the copy column ends in the same place at every
       desktop width — the wash below is pinned to percentages, and a column that
       slid right at narrow widths would slide out from under it. */
    .hero__lead {
      max-width: min(40rem, 50vw);
    }

    /* Now the ramp runs across instead of down: the photograph is barely there
       through the copy and fully itself by the cab. Nothing small reaches past
       55% — only the headline, which is 4rem of 900-weight enamel and carries
       itself over far more photograph than a 12px line can. */
    .hero {
      --ramp: linear-gradient(
        90deg,
        var(--ramp-1) 0%,
        var(--ramp-1) 40%,
        var(--ramp-2) 56%,
        var(--ramp-3) 64%,
        var(--ramp-4) 72%,
        currentColor 84%
      );
    }

    /* Pinned right rather than centred: the crop has to come off something, and
       the left of the frame is sky and skyline the ramp mutes anyway. Off the
       right it would take the front bumper. */
    .hero__media :global(img) {
      object-position: 100% 50%;
    }
  }

  /* Past this width the copy column stops growing, so the ramp can close in and
     hand back another eighth of the frame to the coach. */
  @media (min-width: 80rem) {
    .hero {
      --ramp: linear-gradient(
        90deg,
        var(--ramp-1) 0%,
        var(--ramp-1) 32%,
        var(--ramp-2) 46%,
        var(--ramp-3) 54%,
        var(--ramp-4) 62%,
        currentColor 74%
      );
    }
  }


  /* ---- Trust strip ---- */

  .trust {
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--paper-line);
  }

  .trust__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .trust__item :global(svg) {
    color: var(--enamel-ink);
    flex: none;
  }

  /* ---- Fleet ---- */

  .fleet__coord {
    margin-bottom: var(--space-5);
  }

  .fleet__head {
    max-width: 20ch;
    margin-bottom: var(--space-4);
  }

  .fleet__lede {
    margin-bottom: var(--space-12);
  }

  .fleet__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 46rem) {
    .fleet__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Four across only once there is room for the numeral to stay at display
     scale. Below that, two-up keeps it a plate rather than a caption. */
  @media (min-width: 80rem) {
    .fleet__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .vcard {
    display: grid;
    /* frame, scale, capacity, name, role, link. The role takes the slack so the
       four links sit on one line across the row however the names wrap. */
    grid-template-rows: auto auto auto auto 1fr auto;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Mounted like a sign plate: 3px corners, a scribed keyline a few millimetres
     in, an enamel-deep backing, no shadow. Same treatment the /fleet shots and
     the service rows carry. */
  .vcard__frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .vcard__frame::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  /* 16:10 rather than 3:2. The vehicle photographs run from 1.5:1 to 2:1, and
     at 3:2 `cover` took 12.5% off each side of the widest one — which is exactly
     where the front bumper and the tail are. This frame crops all four inside
     their own margins. */
  .vcard__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 320ms var(--ease-out);
  }

  /* The same frame with the capacity drawn in it, for a vehicle we have not
     photographed. It fills the identical box, so a row of four is a row of four
     whether or not the photographs have arrived. */
  .vcard__drawn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    aspect-ratio: 16 / 10;
    padding: var(--space-6);
    background-image: var(--enamel-pattern);
    color: var(--signal);
  }

  .vcard__num {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .vcard__unit {
    display: block;
    margin-top: var(--space-3);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-dim);
  }

  /* Capacity as length. Every bar in the row is drawn against the same ceiling,
     so the four together are the fleet to scale — the one thing four numbers
     side by side do not tell you at a glance. */
  .vcard__scale {
    display: block;
    width: var(--of);
    height: 3px;
    margin-top: var(--space-4);
    background: var(--enamel-ink);
  }

  .vcard__cap {
    margin-top: var(--space-4);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .vcard__capnum {
    font-size: 0.9375rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--enamel-ink);
  }

  .vcard__name {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .vcard__role {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .vcard__more {
    margin-top: var(--space-5);
    align-self: end;
    justify-self: start;
  }

  /* The photograph pushes in slightly under the cursor. The frame clips it, so
     the mount stays exactly where it was and only the image moves. */
  .vcard:hover .vcard__frame :global(img) {
    transform: scale(1.03);
  }

  /* The card is one link, so the ring belongs to the card and not to the phrase
     inside it that happens to be focusable-looking. */
  .vcard:focus-visible {
    outline: 3px solid var(--hivis);
    outline-offset: 4px;
    border-radius: 1px;
  }

  /* ---- Services ---- */

  .services__head {
    max-width: 18ch;
    margin-bottom: var(--space-12);
  }

  .services__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--enamel-line);
  }

  .dest {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--enamel-line);
    text-decoration: none;
    color: var(--signal);
    transition:
      padding-inline 240ms var(--ease-out),
      background 240ms var(--ease-out);
  }

  .dest:hover {
    padding-inline: var(--space-4);
    background: rgb(255 255 255 / 0.05);
  }

  .dest__shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .dest__shot::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
