---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import SeatPlan from '../components/SeatPlan.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { FLEET, MAX_SINGLE_VEHICLE } from '../data/fleet';
import { BUSINESS } from '../config/site';
import coachExterior from '../assets/images/coach-exterior.jpg';
import coachInterior from '../assets/images/coach-interior.png';
import coachBus44 from '../assets/images/coach-bus-44.png';
import coachBus28 from '../assets/images/coach-bus-28.png';
import executiveSprinter from '../assets/images/excutive-sprinter.png';

/**
 * Every vehicle's own photography, keyed by slug. The Supercoach carries two
 * frames because an interior exists for it; the rest carry one. A slug with no
 * entry falls back to the drawn capacity below rather than borrowing another
 * vehicle's photograph.
 */
const SHOTS: Record<string, { src: ImageMetadata; alt: string }[]> = {
  supercoach: [
    { src: coachExterior, alt: 'The Supercoach bus, luggage bays open' },
    { src: coachInterior, alt: 'Interior of the Supercoach: high back leather reclining seats down both sides of the aisle' },
  ],
  coach: [
    { src: coachBus44, alt: 'The Coach Bus, a white full-length coach, seen from the front and side' },
  ],
  'small-coach': [
    { src: coachBus28, alt: 'The Small Coach Bus, a white short coach, seen from the front and side' },
  ],
  'executive-sprinter': [
    { src: executiveSprinter, alt: 'The Executive Sprinter Van, a black high-roof Mercedes-Benz Sprinter, seen from the front and side' },
  ],
};

const SMALLEST = Math.min(...FLEET.map((v) => v.seatsMin));
---

<Layout
  path="/fleet"
  title="Charter Coach, Shuttle Bus Rentals Chicago | Fleet"
  description="The Chicago Super Coach fleet: Supercoach Bus 50–57, Coach Bus 39–44, Small Coach Bus 22–28 and Executive Sprinter Van 13–16 passengers. Chicago charter bus rental."
>
  <PageHead
    coordinate={`${SMALLEST}–${MAX_SINGLE_VEHICLE} passengers`}
    title="Four vehicles, by the number that decides."
    lede="Capacity is what decides a charter, so it leads. Pick the size that fits the group and we will confirm the exact seat count when we quote."
  />

  <div class="section">
    <div class="shell vehicles">
      {
        FLEET.map((v) => (
          <article class="v" id={v.slug}>
            <div class="v__figure">
              {(SHOTS[v.slug] ?? []).map((shot) => (
                <figure class="v__shot">
                  <Image src={shot.src} alt={shot.alt} widths={[420, 720, 1028]} sizes="(min-width: 60rem) 44vw, 92vw" />
                </figure>
              ))}
              {v.layout && <SeatPlan vehicle={v} />}
              {/* Neither a photograph nor a seating plan yet. The capacity is
                  drawn instead — the one thing about this vehicle that is
                  confirmed — rather than padding the column with a stand-in. */}
              {!SHOTS[v.slug] && !v.layout && (
                <p class="v__only">
                  <span class="v__onlynum">{v.capacityLabel}</span>
                  <span class="v__onlyunit mono">passengers</span>
                </p>
              )}
            </div>

            <div class="v__body">
              <h2 class="title v__name">{v.name}</h2>
              <p class="v__cap mono">
                <span class="v__capnum">{v.capacityLabel}</span> passengers
              </p>
              <p class="lede v__role">{v.role}</p>

              {v.amenities.length > 0 && (
                <Fragment>
                  <h3 class="v__subhead mono">On board</h3>
                  <ul class="v__amenities">
                    {v.amenities.map((a) => (
                      <li>
                        <Icon name="check" size={15} />
                        {a}
                      </li>
                    ))}
                  </ul>
                </Fragment>
              )}

              <div class="v__actions">
                <a class="action" href="/#quote-form">
                  Quote this vehicle
                  <Icon name="arrow" size={16} />
                </a>
                <a class="action action--ink" href={BUSINESS.phone.href}>
                  <Icon name="phone" size={16} />
                  {BUSINESS.phone.display}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <section class="section--tight field field--deep note">
    <div class="shell">
      <h2 class="subtitle note__head">More than {MAX_SINGLE_VEHICLE} passengers?</h2>
      <p class="lede note__body">
        Groups above a single Supercoach are handled case by case. Call us with
        the headcount and date and we will confirm what we can run — we would
        rather tell you plainly than promise a fleet size we have not committed
        to you.
      </p>
      <a class="action" href="/#quote-form">
        Start a quote
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>
</Layout>

<style>
  .vehicles {
    display: grid;
    gap: clamp(var(--space-12), 10vw, var(--space-16));
  }

  .v {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    scroll-margin-top: 6rem;
  }

  @media (min-width: 60rem) {
    .v {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-16);
      align-items: start;
    }
  }

  .v__figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  /* Photographs are mounted like sign plates: square corners, a scribed
     keyline, no shadow. */
  .v__shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .v__shot::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  .v__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* The capacity standing on its own, for a vehicle with neither a photograph
     nor a plan. Set at the scale a photograph would have occupied so the row
     still has a left-hand weight to it. */
  .v__only {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    background: var(--paper-lift);
  }

  .v__onlynum {
    font-size: clamp(3.25rem, 8vw, 5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--enamel-ink);
  }

  .v__onlyunit {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .v__name {
    margin-bottom: var(--space-3);
  }

  .v__cap {
    margin-bottom: var(--space-5);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .v__capnum {
    display: inline-block;
    margin-right: var(--space-2);
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--enamel-ink);
    vertical-align: -0.15em;
  }

  .v__role {
    max-width: 44ch;
    margin-bottom: var(--space-8);
  }

  .v__subhead {
    margin: 0 0 var(--space-4);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .v__amenities {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .v__amenities li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .v__amenities :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--enamel-ink);
  }

  .v__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .note__head {
    margin-bottom: var(--space-4);
  }

  .note__body {
    max-width: 56ch;
    margin-bottom: var(--space-8);
  }
</style>
