---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import SeatPlan from '../components/SeatPlan.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { FLEET, MAX_SINGLE_VEHICLE, vehicleHref } from '../data/fleet';
import { listingShotsFor } from '../data/fleetPhotos';

const SMALLEST = Math.min(...FLEET.map((v) => v.seatsMin));
---

<Layout
  path="/fleet"
  title="Charter Coach, Shuttle Bus Rentals Chicago | Fleet"
  description="The Chicago Super Coach fleet: Supercoach Bus 50–57, Coach Bus 39–44, Small Coach Bus 22–28 and Executive Sprinter Van 13–16 passengers. Chicago charter bus rental."
>
  <PageHead
    coordinate={`${SMALLEST}–${MAX_SINGLE_VEHICLE} passengers`}
    title="Four vehicles, by the number that decides."
    lede="Capacity is what decides a charter, so it leads. Pick the size that fits the group and we will confirm the exact seat count when we quote."
  />

  <div class="section--tight">
    <div class="shell vehicles">
      {
        FLEET.map((v, i) => {
        const shots = listingShotsFor(v.slug);
        return (
          <article class="v" id={v.slug} data-shots={shots.length}>
            <div class="v__figure">
              {shots.map((shot, j) => (
                <figure class="v__shot">
                  <span class="v__plate">
                    {/* The first vehicle's exterior is the first thing below
                        the nameplate — it is the page's opening image, not
                        something scrolled to, so it loads with the page. */}
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[420, 720, 1028]}
                      sizes="(min-width: 82rem) 37rem, (min-width: 60rem) 44vw, 92vw"
                      loading={i === 0 && j === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 && j === 0 ? 'high' : 'auto'}
                    />
                  </span>
                  {shots.length > 1 && (
                    <figcaption class="v__view mono">{shot.view}</figcaption>
                  )}
                </figure>
              ))}
              {/* No photograph yet. The capacity is drawn instead — the one
                  thing about this vehicle that is confirmed — rather than
                  padding the column with a stand-in. */}
              {shots.length === 0 && (
                <p class="v__only">
                  <span class="v__onlynum">{v.capacityLabel}</span>
                  <span class="v__onlyunit mono">passengers</span>
                </p>
              )}
            </div>

            {/* The specification column. Each part is introduced by a ruled
                coordinate so the column reads as a spec sheet with sections
                rather than one long stack, and the seating plan sits here —
                beside the capacity it draws, and directly above the button it
                argues for — rather than lengthening the photograph column. */}
            <div class="v__body">
              <h2 class="title v__name">{v.name}</h2>
              <p class="v__cap mono">
                <span class="v__capnum">{v.capacityLabel}</span> passengers
              </p>
              <p class="lede v__role">{v.role}</p>

              {/* Every vehicle carries both sections, so the four rows are the
                  same object. Where the owner has not supplied a spec, the
                  section says so and points at the phone rather than borrowing
                  another vehicle's fittings — the one thing this page must not
                  do. */}
              <div class="v__spec">
                <div class="v__block">
                  <h3 class="coordinate coordinate--ink v__sec">On board</h3>
                  {v.amenities.length > 0 ? (
                    <ul class="v__amenities">
                      {v.amenities.map((a) => (
                        <li>
                          <Icon name="check" size={15} />
                          {a}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="v__pending">
                      We have not published a fittings list for this vehicle —
                      call and we will confirm what it carries.
                    </p>
                  )}
                </div>

                <div class="v__block">
                  <h3 class="coordinate coordinate--ink v__sec">Seating</h3>
                  {v.layout ? (
                    <SeatPlan vehicle={v} />
                  ) : (
                    <p class="v__pending">
                      No seating plan published for this size yet. The exact
                      seat count is confirmed with your quote.
                    </p>
                  )}
                </div>
              </div>

              {/* Quote stays the amber one: this is a listing, and the page it
                  lists toward is not the conversion. The phone number it
                  replaced is still in the masthead and in the footer of every
                  page, so nothing was taken away — a second identical phone
                  button on each of four rows was the least useful thing here. */}
              <div class="v__actions">
                <a class="action" href="/#quote-form">
                  Quote this vehicle
                  <Icon name="arrow" size={16} />
                </a>
                <a class="action action--ink" href={vehicleHref(v)}>
                  View this vehicle
                  <Icon name="arrow" size={16} />
                </a>
              </div>
            </div>
          </article>
        );
        })
      }
    </div>
  </div>

  <section class="section--tight field field--deep note">
    <div class="shell">
      <h2 class="subtitle note__head">More than {MAX_SINGLE_VEHICLE} passengers?</h2>
      <p class="lede note__body">
        Groups above a single Supercoach are handled case by case. Call us with
        the headcount and date and we will confirm what we can run — we would
        rather tell you plainly than promise a fleet size we have not committed
        to you.
      </p>
      <a class="action" href="/#quote-form">
        Start a quote
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>
</Layout>

<style>
  .vehicles {
    display: grid;
    gap: var(--space-8);
  }

  /* Four vehicles read as a catalogue, so each opens on the same hairline the
     rest of the site uses for a section boundary. It also gives the `#slug`
     deep links a visible top edge to land against. The rule is what lets the
     rows sit this close: the boundary is drawn, so it does not have to be a
     gap wide enough to read as one. */
  .v {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-8);
    border-top: 1px solid var(--paper-line);
    scroll-margin-top: 6rem;
  }

  @media (min-width: 60rem) {
    .v {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
    }

    /* The spec column takes the row's full height and drops its buttons to the
       foot of it, so every row closes on one line: the second photograph ends,
       the call to action ends, and the hairline for the next vehicle follows.
       Left to sit at its natural height the column stopped up to 135px short,
       which put the row's dead space exactly where its call to action was. */
    .v__body {
      display: flex;
      flex-direction: column;
    }

    .v__actions {
      margin-top: auto;
    }
  }

  .v__figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .v__shot {
    margin: 0;
  }

  /* Photographs are mounted like sign plates: square corners, a scribed
     keyline, no shadow. The mount is its own element so the caption sits
     outside the clip rather than under it. */
  .v__plate {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .v__plate::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  /* 16:10, the ratio the homepage fleet grid already settled on: these
     exteriors run 1.5:1 to 2:1, and 3:2 took 12.5% off each side of the
     widest — exactly where a coach keeps its bumper and its tail. One ratio
     for a fleet photograph wherever it appears. */
  .v__plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .v__view {
    margin-top: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* The capacity standing on its own, for a vehicle with neither a photograph
     nor a plan. Set at the scale a photograph would have occupied so the row
     still has a left-hand weight to it. */
  .v__only {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    background: var(--paper-lift);
  }

  .v__onlynum {
    font-size: clamp(3.25rem, 8vw, 5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--enamel-ink);
  }

  .v__onlyunit {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* 1.75rem is 28px, between `space-6` and `space-8` and on neither. It is set
     here rather than snapped to the scale because it is the distance the
     buttons stand off the foot of the row, and the two nearest steps read as
     flush and as adrift respectively. */
  .v__body {
    padding-bottom: 1.75rem;
  }

  .v__name {
    margin-bottom: var(--space-2);
  }

  .v__cap {
    margin-bottom: var(--space-4);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .v__capnum {
    display: inline-block;
    margin-right: var(--space-2);
    font-size: 2.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--enamel-ink);
    vertical-align: -0.15em;
  }

  .v__role {
    max-width: 44ch;
    margin-bottom: var(--space-6);
  }

  /* Tighter than the `.coordinate` default: at four rows of these the label
     wants to sit on its list, not float above it. */
  .v__sec {
    margin-bottom: var(--space-3);
  }

  /* The two spec sections. Beside one photograph the sheet is nearly twice the
     picture's height, so past 72rem — where the blocks have room to be read
     side by side — it runs two across and the row balances. Beside two
     photographs there is height to fill and it stays one column, which is why
     this keys off the picture count rather than the viewport alone. */
  .v__spec {
    display: grid;
    align-items: start;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 72rem) {
    .v:not([data-shots='2']) .v__spec {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-8);
    }
  }

  .v__amenities {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .v__amenities li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .v__amenities :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--enamel-ink);
  }

  /* A section the owner has not filled in. It states the gap and gives the
     visitor the next move; it never reads as a specification. */
  .v__pending {
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .v__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .note__head {
    margin-bottom: var(--space-4);
  }

  .note__body {
    max-width: 56ch;
    margin-bottom: var(--space-8);
  }
</style>
