---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import CloseBand from '../../components/CloseBand.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES, getService } from '../../data/services';
import { shotsFor } from '../../data/fleetPhotos';
import { TESTIMONIALS } from '../../data/testimonials';
import {
  GUEST_RUN,
  PACKAGE,
  PARTY_RUN,
  SISTER,
  WEDDING_FAQ,
} from '../../data/weddings';
import { BUSINESS, SITE_ORIGIN } from '../../config/site';

import trolleyAndCoach from '../../assets/images/wedding/trolley-coach-tall.webp';
import trolleyAtVenue from '../../assets/images/wedding/trolley-at-venue.webp';

/**
 * Weddings gets a page of its own rather than the five-service template.
 *
 * It sits at /services/weddings, which is where it already sat: the old site's
 * `#WeddingTransportationServices` anchor resolves here (src/data/redirects.ts),
 * so this URL carries whatever the wedding content had earned. A second page at
 * /weddings would compete with it for the same query and split that between two
 * URLs — the one thing a rebuild on an indexed domain must not do. The static
 * route wins over `[service].astro`, which now skips this slug.
 *
 * The service record still holds the headline, proposition and meta. None of
 * that is retyped here: this page is a bigger presentation of the same data,
 * not a fork of it.
 */
const service = getService('weddings')!;
const others = SERVICES.filter((s) => s.slug !== service.slug);
const path = `/services/${service.slug}`;

/** This site's own wedding review. Found by context so it cannot go stale. */
const weddingReview = TESTIMONIALS.find((t) => t.context === 'Wedding');

/**
 * The coach that does the guest run, from the same record /fleet reads — so the
 * vehicle beside the run sheet is the vehicle at the other end of the link, and
 * it is the operator's own photograph rather than the rendered one in the
 * package composite. Each run sheet carries its vehicle: without both, the
 * picture on one card pushes its stops half a card below the other's and the
 * two routes stop reading as one timeline.
 */
const coachShot = shotsFor('coach')[0];

/**
 * FAQPage, and worth being clear about what it does and does not buy: Google
 * withdrew FAQ rich results for ordinary commercial sites, so this earns no
 * stars in a listing. It is emitted because it is accurate — these questions
 * and answers are on the page, in this order — and accurate structured data is
 * still how an engine and an assistant read what a page actually answers.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${new URL(path, SITE_ORIGIN).href}#faq`,
  mainEntity: WEDDING_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  path={path}
  title={service.meta.title}
  description={service.meta.description}
  ogImage={trolleyAndCoach.src}
  jsonLd={[faqSchema]}
>
  <PageHead
    coordinate={service.destination}
    title={service.headline}
    lede={service.proposition}
  />

  {/* ---- Two vehicles, two companies, one day ---- */}
  <section class="section--tight pkg" aria-labelledby="package-head">
    <div class="shell pkg__grid">
      {/* Hoisted out of the body column so it heads the whole section rather
          than one half of it. On a phone that matters: without it the section
          opened on an unannounced 440px photograph, and with the photograph
          moved below the body instead it ended up orphaned under the buttons,
          reading as the start of the next section. */}
      <h2 class="coordinate coordinate--ink pkg__tag">The wedding package</h2>

      <figure class="pkg__fig">
        <span class="pkg__plate">
          <Image
            src={trolleyAndCoach}
            alt="A white trolley and a white coach bus, each parked at the entrance of a wedding venue"
            widths={[420, 640, 900, 1122]}
            sizes="(min-width: 64rem) 34rem, (min-width: 44rem) 62vw, 92vw"
            loading="lazy"
          />
        </span>
        <figcaption class="pkg__cap mono">
          The trolley and the coach, on the same day
        </figcaption>
      </figure>

      <div class="pkg__body">
        <p class="subtitle pkg__head" id="package-head">
          The wedding party rides a trolley. Everybody else rides the coach.
        </p>
        <p class="pkg__lede">
          Most Chicago weddings need two vehicles doing two different jobs, and
          booking them from two companies is how the timing goes wrong. We run
          the coach. Our sister company, {SISTER.brand}, runs the trolley. One
          timeline covers both.
        </p>

        <ul class="pkg__parts">
          {
            PACKAGE.parts.map((part) => (
              <li class="part">
                <p class="part__who mono">{part.carries}</p>
                <p class="part__name gothic">{part.vehicle}</p>
                <p class="part__figure">
                  <b class="part__num">{part.capacity}</b>
                  <span class="part__unit mono">{part.unit}</span>
                  <span class="part__hours mono">{part.duration}</span>
                </p>
                <p class="part__op">
                  Operated by {part.operator}
                </p>
              </li>
            ))
          }
        </ul>

        <ul class="pkg__incl">
          {
            PACKAGE.included.map((line) => (
              <li>
                <Icon name="check" size={15} />
                {line}
              </li>
            ))
          }
        </ul>

        <div class="pkg__actions">
          <a class="action" href="/#quote-form">
            Get this priced
            <Icon name="arrow" size={16} />
          </a>
          {/*
            Followed on purpose. `rel="noopener"` closes the `window.opener`
            hole a `target="_blank"` link opens; it says nothing to a crawler
            and does not withhold the link. Nothing here carries nofollow,
            sponsored or ugc, so this passes equity to the sister site — which
            is what a real editorial recommendation between two companies under
            one owner should do.
          */}
          <a
            class="action action--outline"
            href={SISTER.weddings}
            target="_blank"
            rel="noopener"
          >
            Wedding trolleys at {SISTER.brand}
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---- The two run sheets ---- */}
  <section class="section--tight runs" aria-labelledby="runs-head">
    <div class="shell">
      <h2 class="coordinate coordinate--ink">The day, stop by stop</h2>
      <p class="subtitle runs__head" id="runs-head">
        Two routes, one timeline.
      </p>

      <div class="runs__grid">
        <article class="run run--ours">
          {
            coachShot && (
              <span class="run__shot">
                <Image
                  src={coachShot.src}
                  alt={coachShot.alt}
                  widths={[360, 560, 1120]}
                  sizes="(min-width: 60rem) 35rem, (min-width: 44rem) 46vw, 92vw"
                  loading="lazy"
                />
              </span>
            )
          }
          <header class="run__top">
            <p class="run__tag mono">Chicago Super Coach</p>
            <h3 class="run__name gothic">The coach, for your guests</h3>
            <p class="run__note">
              Hotel to venue and back again, with the coach on site in between.
            </p>
          </header>
          <ol class="run__stops">
            {
              GUEST_RUN.map((stop, i) => (
                <li class="stop">
                  <span class="stop__num mono">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="stop__label">{stop.label}</p>
                    <p class="stop__detail">{stop.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="run__foot">
          <a class="run__go" href="/fleet/coach">
            See the Coach Bus
            <Icon name="arrow" size={15} />
          </a>
          </div>
        </article>

        <article class="run run--sister">
          <span class="run__shot">
            <Image
              src={trolleyAtVenue}
              alt={`${SISTER.brand}'s classic white trolley, parked at the entrance of a wedding venue`}
              widths={[360, 560, 1122]}
              sizes="(min-width: 60rem) 35rem, (min-width: 44rem) 46vw, 92vw"
              loading="lazy"
            />
          </span>
          <header class="run__top">
            <p class="run__tag mono">{SISTER.brand}</p>
            <h3 class="run__name gothic">The trolley, for the wedding party</h3>
            <p class="run__note">
              Not a vehicle in this fleet — our sister company runs it, and this
              is the run it does.
            </p>
          </header>
          <ol class="run__stops">
            {
              PARTY_RUN.map((stop, i) => (
                <li class="stop">
                  <span class="stop__num mono">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="stop__label">{stop.label}</p>
                    <p class="stop__detail">{stop.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="run__foot">
            <a class="run__go" href={SISTER.weddings} target="_blank" rel="noopener">
              Book a wedding trolley at {SISTER.brand}
              <Icon name="arrow" size={15} />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ---- One real wedding review, this site's own ---- */}
  {
    weddingReview && (
      <section class="section--tight field field--deep proof">
        <div class="shell">
          <p class="coordinate proof__tag">From a wedding we drove</p>
          <blockquote class="proof__quote">
            <p>{weddingReview.quote}</p>
          </blockquote>
          <p class="proof__by mono">{weddingReview.name}</p>
        </div>
      </section>
    )
  }

  {/* ---- What couples ask ---- */}
  <section class="section--tight" aria-labelledby="faq-head">
    <div class="shell">
      <h2 class="coordinate coordinate--ink">Before you book</h2>
      <p class="subtitle faq__head" id="faq-head">Questions couples send us.</p>
      <dl class="faq">
        {
          WEDDING_FAQ.map((item) => (
            <div class="faq__item">
              <dt class="faq__q">{item.q}</dt>
              <dd class="faq__a">
                {item.a}
                {item.link && (
                  <>
                    {' '}
                    <a
                      class="faq__link"
                      href={item.link.href}
                      {...(item.link.external
                        ? { target: '_blank', rel: 'noopener' }
                        : {})}
                    >
                      {item.link.label}
                      <Icon name="arrow" size={14} />
                    </a>
                  </>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section--tight rest">
    <div class="shell">
      <h2 class="coordinate coordinate--ink">Other services</h2>
      <ul class="others">
        {
          others.map((o) => (
            <li>
              <a class="other" href={`/services/${o.slug}`}>
                <span class="other__name">{o.name}</span>
                <Icon name="arrow" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="rest__phone">
        Office {BUSINESS.hours.officeSummary} — {BUSINESS.hours.charterNote}.{' '}
        <a href={BUSINESS.phone.href}>{BUSINESS.phone.display}</a>
      </p>
    </div>
  </section>

  <CloseBand />
</Layout>

<style>
  /* ---- The package ---- */

  .pkg {
    border-top: 1px solid var(--paper-line);
  }

  .pkg__grid {
    display: grid;
    gap: var(--space-8);
  }

  /* The photograph is a tall one — it is two vehicles stacked, which is the
     whole point of it — so it gets the narrower column and the argument gets
     the wider. */
  @media (min-width: 64rem) {
    .pkg__grid {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
      gap: var(--space-8) var(--space-12);
      align-items: start;
    }

    /* The coordinate rule runs the full width of the section, which is what a
       coordinate line is for: it measures the whole plate, not one column. */
    .pkg__tag {
      grid-column: 1 / -1;
    }
  }

  .pkg__fig {
    margin: 0;
  }

  /* Mounted-Photograph Rule: a scribed keyline a few millimetres in from the
     plate edge, the same one every photograph on the site carries. */
  .pkg__plate {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .pkg__plate::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  .pkg__plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pkg__cap {
    margin-top: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .pkg__head {
    max-width: 20ch;
    margin-bottom: var(--space-5);
  }

  .pkg__lede {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .pkg__parts {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 30rem) {
    .pkg__parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Square, like the aside above it and every other plate on this site that
     carries a 3px accent edge: a thick edge and a rounded corner fight, and the
     edge is the one doing the work. Photographs keep the plate radius. */
  .part {
    padding: var(--space-5);
    border: 1px solid var(--paper-line);
    border-top: 3px solid var(--enamel-ink);
    background: var(--paper-lift);
  }

  .part__who {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .part__name {
    margin-top: var(--space-1);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .part__figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .part__num {
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--enamel-ink);
  }

  .part__unit {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* Set apart from the capacity by a drawn rule rather than by punctuation:
     two different measurements of the same booking. */
  .part__hours {
    margin-left: auto;
    padding-left: var(--space-3);
    border-left: 1px solid var(--paper-line);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .part__op {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--paper-line);
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }

  .pkg__incl {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .pkg__incl li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .pkg__incl :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--enamel-ink);
  }

  .pkg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* ---- Run sheets ---- */

  .runs {
    border-top: 1px solid var(--paper-line);
  }

  .runs__head {
    margin-block: var(--space-4) var(--space-8);
  }

  .runs__grid {
    display: grid;
    gap: var(--space-8);
  }

  /* Stretched rather than start-aligned: the two cards hold different numbers
     of stops, and letting them find their own heights left the shorter one
     floating with its link halfway up the row. */
  @media (min-width: 60rem) {
    .runs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
    }
  }

  /* Square for the same reason as `.part` — both cards carry a 3px top edge. */
  .run {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--paper-line);
    background: var(--paper-lift);
  }

  /* The one this company drives is the one with the enamel edge. The sister
     card is a genuine recommendation and is drawn as one — same weight of
     information, quieter edge. */
  .run--ours {
    border-top: 3px solid var(--enamel-ink);
  }

  .run--sister {
    border-top: 3px solid var(--paper-line);
  }

  .run__shot {
    position: relative;
    display: block;
    overflow: hidden;
    margin-bottom: var(--space-5);
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .run__shot::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  .run__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .run__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .run__name {
    margin-top: var(--space-2);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .run__note {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .run__stops {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* The route drawn as a route: each numeral carries the line down to the next
     stop, so the column reads as one journey rather than five bullets. */
  .stop__num {
    position: relative;
    align-self: start;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--enamel-ink);
  }

  .stop:not(:last-child) .stop__num::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(100% + 4px);
    width: 1px;
    height: calc(100% + var(--space-5));
    background: var(--paper-line);
  }

  .stop__label {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .stop__detail {
    margin-top: var(--space-1);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  /* The wrapper takes the auto margin, not the link: `margin-top: auto` on a
     link collapses to nothing the moment its column is full, and then the link
     sits against the last stop. Padding on a wrapper is a floor the auto margin
     cannot eat, so both cards close on a line however many stops they hold. */
  .run__foot {
    margin-top: auto;
    padding-top: var(--space-8);
  }

  .run__go {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--enamel-ink);
    transition: gap 200ms var(--ease-out);
  }

  .run__go:hover {
    gap: var(--space-3);
    color: var(--hivis-text);
  }

  .run__go :global(svg) {
    flex: none;
  }

  /* ---- Proof ---- */

  .proof__tag {
    color: var(--azure);
  }

  .proof__quote {
    max-width: 44ch;
    margin: var(--space-5) 0 0;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .proof__by {
    margin-top: var(--space-5);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-dim);
  }

  /* ---- FAQ ---- */

  .faq__head {
    margin-block: var(--space-4) var(--space-8);
  }

  .faq {
    display: grid;
    gap: var(--space-8) var(--space-12);
    margin: 0;
  }

  @media (min-width: 56rem) {
    .faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .faq__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--paper-line);
  }

  .faq__q {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .faq__a {
    margin: var(--space-3) 0 0;
    max-width: 48ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-dim);
  }

  .faq__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    color: var(--enamel-ink);
    text-underline-offset: 4px;
  }

  .faq__link:hover {
    color: var(--hivis-text);
  }

  /* ---- Other services ---- */

  .rest {
    border-top: 1px solid var(--paper-line);
  }

  .others {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .other {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .other:hover {
    border-color: var(--enamel-ink);
    background: var(--paper-lift);
  }

  .other__name {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .other :global(svg) {
    color: var(--ink-dim);
    flex: none;
  }

  .other:hover :global(svg) {
    color: var(--hivis-text);
  }

  .rest__phone {
    margin-top: var(--space-6);
    font-size: 0.9375rem;
    color: var(--ink-dim);
  }

  .rest__phone a {
    font-weight: 800;
    color: var(--enamel-ink);
    text-underline-offset: 4px;
  }
</style>
