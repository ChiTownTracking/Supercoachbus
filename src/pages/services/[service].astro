---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import Icon from '../../components/Icon.astro';
import LinkedText from '../../components/LinkedText.astro';
import LandingQuote from '../../components/LandingQuote.astro';
import LandingActions from '../../components/LandingActions.astro';
import LandingFleet from '../../components/LandingFleet.astro';
import OutOfStateDetails from '../../components/OutOfStateDetails.astro';
import { BESPOKE_SERVICE_PAGES, LISTED_SERVICES, SERVICES } from '../../data/services';
import { SERVICE_PHOTOS } from '../../data/servicePhotos';
import { GUIDES } from '../../data/guides';
import { BUSINESS, SITE_ORIGIN } from '../../config/site';
import openRoad from '../../assets/images/out-of-state/open-road-pexels.jpg';

/**
 * Every service except the ones that ship their own page. Weddings is the first:
 * it sits at the same /services/weddings URL, which is the one the old site's
 * `#WeddingTransportationServices` anchor resolves to, so it had to stay put
 * rather than move to /weddings and split the query between two URLs.
 */
export function getStaticPaths() {
  return SERVICES.filter(
    (service) => !(BESPOKE_SERVICE_PAGES as readonly string[]).includes(service.slug)
  ).map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const path = `/services/${service.slug}`;
const canonical = new URL(path, SITE_ORIGIN).href;
const others = LISTED_SERVICES.filter((s) => s.slug !== service.slug);
const photo = SERVICE_PHOTOS[service.slug];
const isOutOfState = service.slug === 'long-distance-charter-bus-rental';
const tripBackground = isOutOfState
  ? await getImage({ src: openRoad, width: 1000, format: 'webp', quality: 75 })
  : undefined;

/**
 * Structured data, and only what this page can honestly claim.
 *
 * `Service` names the offering and points `provider` at the LocalBusiness node
 * the layout already emits — one company, one node, referenced by id rather
 * than described twice. `FAQPage` is emitted only where the questions are
 * genuinely on the page, in this order; it earns no rich result for an ordinary
 * commercial site, and it is here because it is accurate.
 */
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: service.headline,
  serviceType: service.name,
  description: service.meta.description,
  url: canonical,
  image: new URL(photo.src.src, SITE_ORIGIN).href,
  provider: { '@id': `${SITE_ORIGIN}/#business` },
  areaServed: [
    { '@type': 'City', name: 'Chicago' },
    { '@type': 'AdministrativeArea', name: 'Chicago metropolitan area' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_ORIGIN}/services` },
    { '@type': 'ListItem', position: 3, name: service.name, item: canonical },
  ],
};

const faqSchema = service.faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: service.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const schema = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout
  path={path}
  bookingHref="#quote-form"
  title={service.meta.title}
  description={service.meta.description}
  ogImage={photo.src.src}
  ogImageAlt={photo.alt}
  jsonLd={schema}
>
  {/* The trail runs above the name, where a trail runs. Inside the band it had
      to sit under the heading because the band was the whole header; on the
      page it can be the first small line and get out of the way. */}
  <PageHero>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/services">Services</a>
    </nav>
    <PageTitle coordinate={service.destination} title={service.headline} scale="hero" />
    <p class="lede svc__lead">{service.proposition}</p>
    {isOutOfState && <nav class="svc__jump" aria-label="On this page">
      <a href="#onboard-comfort">Onboard comfort</a>
      <a href="#trip-planning">Trip planning</a>
      <a href="#trip-cost">Rental cost</a>
    </nav>}
    <LandingActions slot="actions" />
    <figure slot="media">
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 60rem) 46vw, 92vw"
        loading="eager"
      />
    </figure>
  </PageHero>
  <LandingQuote context={service.name} />

  <div class="section">
    <div class:list={['shell', 'svc__grid', isOutOfState && 'svc__grid--trip']}>
      {isOutOfState && service.bodyHeading && <h2 class="subtitle svc__heading">{service.bodyHeading}</h2>}
      <div class="svc__body stack">
        {!isOutOfState && service.bodyHeading && <h2 class="subtitle svc__heading">{service.bodyHeading}</h2>}
        {service.body.map((p) => <p class="svc__p"><LinkedText text={p} links={service.bodyLinks?.filter((link) => p.includes(link.phrase))} quoteHref="#quote-form" /></p>)}

        {
          service.sister && (
            <p class="svc__sister">
              {service.sister.note}{' '}
              <a href={service.sister.href} target="_blank" rel="noopener">
                {service.sister.label}
                <Icon name="arrow" size={15} />
              </a>
            </p>
          )
        }
      </div>

      <aside class:list={['svc__aside', isOutOfState && 'svc__aside--trip']} style={tripBackground ? { '--svc-aside-image': `url("${tripBackground.src}")` } : undefined}>
        <h2 class="coordinate coordinate--ink">{isOutOfState ? 'Choose your trip type' : 'What people ask us'}</h2>
        <dl class="concerns">
          {
            service.concerns.map((c) => (
              <div class="concern">
                <dt class="concern__q">{c.label}</dt>
                <dd class="concern__a">{c.answer}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>

  {isOutOfState && <OutOfStateDetails />}

  <LandingFleet slugs={service.vehicles} />

  {
    service.faq && (
      <section class="section--tight field faq" aria-labelledby="faq-head">
        <div class="shell">
          <p class="coordinate">Before you send the request</p>
          <h2 class="subtitle faq__head" id="faq-head">
            {service.faqHeading ?? 'Questions we get about this trip.'}
          </h2>
          {isOutOfState ? <div class="faq__accordion">
            {service.faq.map((item) => <details class="faq__disclosure">
              <summary>{item.q}<Icon name="chevron" size={16} /></summary>
              <p class="faq__a">{item.a}</p>
            </details>)}
          </div> : <dl class="faq__list">
            {service.faq.map((item) => (
              <div class="faq__item">
                <dt class="faq__q">{item.q}</dt>
                <dd class="faq__a">{item.a}</dd>
              </div>
            ))}
          </dl>}
        </div>
      </section>
    )
  }

  {/* Guides sit between the questions and the call, so the two enamel bands do
      not run together into one green block. Paper, enamel, paper, enamel — the
      alternation is what gives each band an edge to be read against. */}
  <section class="section--tight" aria-labelledby="reading-head">
    <div class="shell">
      <h2 class="coordinate coordinate--ink" id="reading-head">Worth reading first</h2>
      <div class="reading">
        {GUIDES.map((guide) => <GuideCard guide={guide} />)}
      </div>
    </div>
  </section>

  {/* `field` is load-bearing, not decoration: the ghost button is outlined in
      white and is invisible on paper. The band and the button are one design. */}
  <section class="section--tight field cta">
    <div class="shell cta__inner">
      <div>
        <h2 class="subtitle cta__head">{isOutOfState ? 'Ready to Plan Your Out-of-State Trip?' : 'Get this priced.'}</h2>
        <p class="lede cta__body">
          Send the date, the headcount and the route. Office {BUSINESS.hours.officeSummary}.
        </p>
      </div>
      <div class="cta__actions">
        <a class="action" href="#quote-form">
          Get a quote
          <Icon name="arrow" size={16} />
        </a>
        <a class="action action--ghost" href={BUSINESS.phone.href}>
          <Icon name="phone" size={16} />
          {BUSINESS.phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <h2 class="coordinate coordinate--ink">Other services</h2>
      <ul class="others">
        {
          others.map((o) => (
            <li>
              <a class="other" href={`/services/${o.slug}`}>
                <span class="other__name">{o.name}</span>
                <Icon name="arrow" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .svc__lead { max-width: 65ch; margin-top: var(--space-5); }
  .svc__heading { color: var(--enamel-ink); }
  .svc__jump { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); margin-top: var(--space-5); }
  .svc__jump a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--enamel-ink); font-weight: 700; font-size: .875rem; text-underline-offset: 4px; }
  .svc__jump a:focus-visible { outline: 3px solid var(--enamel-ink); outline-offset: 4px; }
  /* No rule over it any more: above the heading it is the first line on the
     page, and a border there would draw a lid on the page rather than separate
     anything. */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .crumbs a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .svc__grid {
    display: grid;
    gap: var(--space-12);
  }

  .svc__grid--trip {
    grid-template-areas: 'heading' 'aside' 'body';
    gap: var(--space-6);
  }

  .svc__grid--trip > .svc__heading { grid-area: heading; }
  .svc__grid--trip > .svc__body { grid-area: body; }
  .svc__grid--trip > .svc__aside { grid-area: aside; }

  @media (min-width: 60rem) {
    .svc__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-16);
      align-items: start;
    }
    .svc__grid--trip {
      grid-template-areas: 'heading aside' 'body aside';
      grid-template-rows: auto 1fr;
      gap: var(--space-6) var(--space-16);
    }
  }

  .svc__body {
    --flow: var(--space-6);
    max-width: var(--measure);
  }

  .svc__p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  /* A handoff, not a footnote: set apart by a rule so it reads as a different
     kind of statement from the body copy above it, without becoming a card. */
  .svc__sister {
    padding-top: var(--space-6);
    border-top: 1px solid var(--paper-line);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .svc__sister a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    color: var(--enamel-ink);
    white-space: nowrap;
    text-underline-offset: 4px;
  }

  .svc__aside {
    padding: var(--space-8);
    border-top: 3px solid var(--enamel-ink);
    background: var(--paper-lift);
  }

  .concerns {
    margin: 0;
    display: grid;
    gap: var(--space-6);
  }

  .concern__q {
    margin-bottom: var(--space-2);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .concern__a {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  @media (width < 60rem) {
    .svc__aside--trip {
      background-color: var(--enamel-deep);
      background-image: linear-gradient(135deg, rgb(6 34 23 / 0.94), rgb(6 34 23 / 0.84)), var(--svc-aside-image);
      background-size: cover;
      background-position: center;
      border-top-color: var(--enamel-line);
      border-radius: var(--radius);
      color: var(--signal);
    }
    .svc__aside--trip .coordinate,
    .svc__aside--trip .concern__a { color: var(--signal); }
  }

  /* ---- Questions, on the enamel band ---- */

  .faq__head {
    margin-top: var(--space-2);
  }

  .faq__list {
    display: grid;
    gap: var(--space-8) var(--space-12);
    margin: var(--space-10) 0 0;
  }

  @media (min-width: 56rem) {
    .faq__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .faq__q {
    margin-bottom: var(--space-3);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .faq__a {
    margin: 0;
    max-width: 58ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--signal-dim);
  }

  .faq__accordion { max-width: 54rem; margin-top: var(--space-8); }
  .faq__disclosure { border-top: 1px solid var(--enamel-line); }
  .faq__disclosure:last-child { border-bottom: 1px solid var(--enamel-line); }
  .faq__disclosure summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); padding-block: var(--space-5); font-size: 1.0625rem; font-weight: 800; cursor: pointer; list-style: none; }
  .faq__disclosure summary::-webkit-details-marker { display: none; }
  .faq__disclosure summary :global(svg) { flex: none; }
  .faq__disclosure[open] summary :global(svg) { transform: rotate(180deg); }
  .faq__disclosure summary:focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }
  .faq__disclosure .faq__a { max-width: 75ch; padding-bottom: var(--space-5); }

  /* ---- Guides ---- */

  .reading {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .cta__head {
    margin-bottom: var(--space-2);
  }

  .cta__body {
    max-width: 44ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .others {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .other {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .other:hover {
    border-color: var(--enamel-ink);
    background: var(--paper-lift);
  }

  .other__name {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .other :global(svg) {
    color: var(--ink-dim);
    flex: none;
  }

  .other:hover :global(svg) {
    color: var(--hivis-text);
  }
</style>
