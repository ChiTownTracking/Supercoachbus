---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../config/site';
import { OPEN_ITEMS } from '../lib/placeholder';

const { address, hours, phone } = BUSINESS;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(
  `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`
)}&output=embed`;
---

<Layout
  path="/contact"
  title="Super Coach Chicago | Contact Us"
  description="Contact Chicago Super Coach for charter bus and shuttle rental. Call 630-624-3448, email info@chicagosupercoach.com, or visit 3717 W. Montrose Avenue, Chicago IL 60618."
>
  <PageHead
    coordinate={`${address.gridCoordinate} · Montrose Avenue`}
    title="Reach a person."
    lede="The fastest answer is the phone. The office keeps business hours; the buses do not."
  />

  <div class="section">
    <div class="shell contact__grid">
      <div class="contact__methods">
        <a class="method method--primary" href={phone.href}>
          <span class="method__label mono">Call</span>
          <span class="method__value">{phone.display}</span>
          <span class="method__note">Office {hours.officeDays}, {hours.officeTime}</span>
          <Icon name="phone" size={22} class="method__icon" />
        </a>

        <a class="method" href={`mailto:${BUSINESS.email}`}>
          <span class="method__label mono">Email</span>
          <span class="method__value method__value--sm">{BUSINESS.email}</span>
          <span class="method__note">We reply within office hours</span>
          <Icon name="mail" size={22} class="method__icon" />
        </a>

        <a class="method" href={BUSINESS.googleMapsUrl} target="_blank" rel="noopener">
          <span class="method__label mono">Visit</span>
          <span class="method__value method__value--sm">
            {address.street}<br />{address.city}, {address.region} {address.postalCode}
          </span>
          <span class="method__note">Open in Google Maps</span>
          <Icon name="pin" size={22} class="method__icon" />
        </a>

        <div class="method method--static">
          <span class="method__label mono">Hours</span>
          <span class="method__value method__value--sm">
            Office {hours.officeDays}<br />{hours.officeTime}
          </span>
          <span class="method__note method__note--hi">{hours.charterNote}</span>
          <Icon name="clock" size={22} class="method__icon" />
        </div>
      </div>

      <div class="contact__form">
        <h2 class="subtitle contact__head">Send a message</h2>
        <p class="contact__sub">
          For a priced charter, the <a href="/#quote-form">quote form</a> asks the right
          questions. This one is for everything else.
        </p>

        <form class="cform" method="post" action="">
          <Placeholder item={OPEN_ITEMS.contactEndpoint} />

          <div class="cform__grid">
            <label class="control" data-required>
              <span>Name</span>
              <input name="name" required autocomplete="name" />
            </label>
            <label class="control" data-required>
              <span>Phone</span>
              <input name="phone" type="tel" required autocomplete="tel" />
            </label>
            <label class="control span-2" data-required>
              <span>Email</span>
              <input name="email" type="email" required autocomplete="email" />
            </label>
            <label class="control span-2" data-required>
              <span>Message</span>
              <textarea name="message" required></textarea>
            </label>
          </div>

          <!-- Consent language mirrors the opt-ins the live site collects. -->
          <div class="optins">
            <label class="optin">
              <input type="checkbox" name="optinTransactional" />
              <span>
                Text me transactional messages about my booking at the number above.
              </span>
            </label>
            <label class="optin">
              <input type="checkbox" name="optinMarketing" />
              <span>
                Send me occasional marketing and promotional messages. Consent is
                not a condition of purchase, and you can reply STOP at any time.
              </span>
            </label>
          </div>

          <button class="action" type="submit">
            Send message
            <Icon name="arrow" size={16} />
          </button>
        </form>
      </div>
    </div>
  </div>

  <section class="map">
    <h2 class="sr-only">Our location</h2>
    <!-- The address sits underneath the embed. If the map is blocked, fails, or
         is stripped by a privacy extension, the band still carries the one thing
         it exists to communicate rather than going blank. -->
    <div class="map__fallback field">
      <p class="mono map__coord">{address.gridCoordinate}</p>
      <p class="map__addr">
        {address.street}<br />{address.city}, {address.region} {address.postalCode}
      </p>
      <!-- Ghost, not amber: the page's primary action is the quote, and two
           amber buttons in one viewport is two primary actions. -->
      <a class="action action--ghost" href={BUSINESS.googleMapsUrl} target="_blank" rel="noopener">
        Get directions
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <iframe
      src={mapEmbed}
      title={`Map showing ${BUSINESS.name} at ${address.street}, ${address.city}`}
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</Layout>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      gap: var(--space-16);
      align-items: start;
    }
  }

  .contact__methods {
    display: grid;
    gap: var(--space-3);
  }

  .method {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    padding-right: var(--space-16);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  a.method:hover {
    border-color: var(--enamel-ink);
    background: var(--paper-lift);
  }

  .method--primary {
    background: var(--enamel);
    background-image: var(--enamel-pattern);
    border-color: var(--enamel);
    color: var(--signal);
  }

  a.method--primary:hover {
    background-color: var(--enamel-lift);
    border-color: var(--hivis);
  }

  .method--static {
    background: var(--paper-lift);
  }

  .method__label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .method--primary .method__label {
    color: var(--azure);
  }

  .method__value {
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .method__value--sm {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
    word-break: break-word;
  }

  .method__note {
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }

  .method--primary .method__note {
    color: var(--signal-dim);
  }

  .method__note--hi {
    color: var(--hivis-text);
    font-weight: 700;
  }

  .method__icon {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    color: var(--paper-line);
  }

  .method--primary .method__icon {
    color: rgb(255 255 255 / 0.4);
  }

  a.method:hover .method__icon {
    color: var(--hivis);
  }

  .contact__head {
    margin-bottom: var(--space-3);
  }

  .contact__sub {
    max-width: 48ch;
    margin-bottom: var(--space-8);
    color: var(--ink-dim);
  }

  .contact__sub a {
    font-weight: 700;
    color: var(--ink);
  }

  .cform {
    display: grid;
    gap: var(--space-6);
  }

  .cform__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .span-2 {
    grid-column: 1 / -1;
  }

  @media (max-width: 34rem) {
    .cform__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .optins {
    display: grid;
    gap: var(--space-4);
  }

  .optin {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-dim);
    cursor: pointer;
  }

  .optin input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 2px 0 0;
    accent-color: var(--enamel-ink);
  }

  .cform .action {
    justify-self: start;
  }

  .map {
    display: grid;
    height: clamp(18rem, 40vh, 26rem);
    border-top: 1px solid var(--paper-line);
  }

  .map__fallback,
  .map iframe {
    grid-area: 1 / 1;
  }

  .map__fallback {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
    padding: var(--space-6);
  }

  .map__coord {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--azure);
  }

  .map__addr {
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .map iframe {
    position: relative;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: saturate(0.75);
  }
</style>
