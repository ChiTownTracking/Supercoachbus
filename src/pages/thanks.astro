---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../config/site';
---

<Layout
  path="/thanks"
  title="Request Received | Chicago Super Coach"
  description="Your message or trip request was sent to Chicago Super Coach."
  noindex
>
  <PageHead
    coordinate="Message received"
    title="Thank you. We have it."
    lede={`We reply during office hours: ${BUSINESS.hours.officeSummary}. Submitting a reservation request does not hold a vehicle until we confirm it with you directly.`}
  />

  <section class="section">
    <div class="shell thanks">
      <div>
        <h2 class="subtitle">Need an answer sooner?</h2>
        <p class="thanks__copy">
          Call the office and tell us you have already sent the form so we can
          find the request quickly.
        </p>
      </div>
      <div class="thanks__actions">
        <a class="action action--ink" href={BUSINESS.phone.href}>
          <Icon name="phone" size={16} />
          {BUSINESS.phone.display}
        </a>
        <a class="direction thanks__home" href="/">
          Return home
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .thanks__copy {
    max-width: 48ch;
    margin-top: var(--space-4);
    line-height: 1.65;
    color: var(--ink-dim);
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .thanks__home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--enamel-ink);
  }

  @media (max-width: 35rem) {
    .thanks__actions {
      width: 100%;
      align-items: stretch;
      flex-direction: column;
    }

    .thanks__actions .action {
      justify-content: center;
    }
  }
</style>
