---
import { BUSINESS } from "../config/site";
import Icon from "./Icon.astro";
import {
  EVENT_TYPES,
  HOURS,
  OUT_OF_STATE,
  PASSENGER_OPTIONS,
  VEHICLE_OPTIONS,
} from "../data/formOptions";

/**
 * The reservation form, with the destination blade below it as a receipt.
 *
 * The blade is the signature of this build. It stays hidden until the request is
 * submitted, then sets itself the way a coach's destination sign is set and
 * names how the group is carried — honest capacity arithmetic against
 * src/data/fleet.ts, never a sales suggestion. It used to sit above the form as
 * a live preview; it now confirms rather than predicts, matching QuickQuote.
 *
 * It never claims a delivery that did not happen. "Successfully submitted" is
 * printed only when Netlify accepts the URL-encoded POST; a failed request says
 * so plainly and offers the phone.
 *
 * This asks the same questions in the same order as the homepage QuickQuote, off
 * the same option lists in data/formOptions.ts. Fields may also arrive prefilled
 * from a query string, including the wedding package planner, and the resulting
 * URL is shareable (see the block in the script).
 */
interface Props {
  mode: "quote" | "reserve";
}

const { mode } = Astro.props;
const isReserve = mode === "reserve";
const formName = isReserve ? "reservation-request" : "quote-request";
---

<div class="booking">
  <form
    class="booking__form"
    data-booking
    name={formName}
    method="post"
    action="/thanks/"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value={formName} />
    <p class="sr-only" aria-hidden="true">
      <label>
        Do not fill this out if you are human:
        <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <fieldset class="booking__set">
      <legend class="coordinate coordinate--ink">The trip</legend>
      <div class="grid">
        <label class="control half">
          <span>Pickup location</span>
          <input
            name="pickup"
            data-field="from"
            placeholder="Hotel, office, school or address"
          />
        </label>
        <label class="control half">
          <span>Drop-off location</span>
          <input
            name="dropoff"
            data-field="to"
            placeholder="Venue, stadium or address"
          />
        </label>
        <label class="control">
          <span>Passengers</span>
          <select name="passengers" data-field="count">
            <option value="">Select</option>
            {PASSENGER_OPTIONS.map((p) => <option value={p}>{p}</option>)}
          </select>
        </label>
        <label class="control">
          <span>Date of service</span>
          <input name="date" type="date" />
        </label>
        <label class="control">
          <span>Pickup time</span>
          <input name="time" type="time" />
        </label>
        <label class="control">
          <span>Hours needed</span>
          <select name="hours">
            <option value="">Select</option>
            {
              HOURS.map((h) => (
                <option
                  value={h}
                  data-out-of-state={h === OUT_OF_STATE ? "" : undefined}
                >
                  {h}
                </option>
              ))
            }
          </select>
        </label>
        <!-- Only asked for an out-of-state trip, which is quoted in days rather
             than in a block of hours. The reveal is CSS off the live selection,
             so it still works with JavaScript unavailable; the script only
             clears the count when the answer moves back to a block of hours. -->
        <label class="control control--days">
          <span>Number of days needed</span>
          <input
            name="days"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            placeholder="e.g. 3"
          />
        </label>
        <label class="control">
          <span>Event type</span>
          <select name="eventType">
            <option value="">Select</option>
            {EVENT_TYPES.map((e) => <option value={e}>{e}</option>)}
          </select>
        </label>
        <!-- Vehicle is asked as a preference, not a requirement: the fleet is one
             coach, so the default is "recommend one" and the blade above states
             what actually carries the group from the headcount. -->
        <label class="control">
          <span>Type of vehicle</span>
          <select name="vehicle">
            {
              VEHICLE_OPTIONS.map((v) => (
                <option value={v.value}>{v.label}</option>
              ))
            }
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset class="booking__set">
      <legend class="coordinate coordinate--ink">You</legend>
      <div class="grid">
        <label class="control">
          <span>Name</span>
          <input name="name" autocomplete="name" />
        </label>
        <label class="control" data-required>
          <span>Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label class="control">
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label class="control full">
          <span>Special notes</span>
          <textarea
            name="notes"
            placeholder="Multiple pickups, return timing, luggage, accessibility needs"
          ></textarea>
        </label>
      </div>
    </fieldset>

    <fieldset class="booking__set">
      <legend class="coordinate coordinate--ink">Payment information</legend>

      <div class="grid">
        <label class="control full">
          <span>Name on card</span>
          <input
            name="billingName"
            type="text"
            autocomplete="cc-name"
            placeholder="Name as shown on card"
          />
        </label>

        <label class="control full">
          <span>Card number</span>
          <input
            name="cardNumber"
            type="text"
            inputmode="numeric"
            autocomplete="cc-number"
            placeholder="1234 5678 9012 3456"
          />
        </label>

        <label class="control pair">
          <span>Expiration date</span>
          <input
            name="cardExpiration"
            type="text"
            inputmode="numeric"
            autocomplete="cc-exp"
            maxlength="5"
            placeholder="MM/YY"
            pattern="(0[1-9]|1[0-2])\/[0-9]{2}"
            oninput="
          let v = this.value.replace(/\D/g, '').slice(0, 4);
          if (v.length >= 3) {
            v = v.slice(0, 2) + '/' + v.slice(2);
          }
          this.value = v;
        "
          />
        </label>

        <label class="control pair">
          <span>Security code (CVV)</span>
          <input
            name="cardCvv"
            type="text"
            inputmode="numeric"
            autocomplete="cc-csc"
            maxlength="4"
            placeholder="123"
            pattern="[0-9]{3,4}"
          />
        </label>

        <label class="control full">
          <span>Billing street address</span>
          <input
            name="billingAddress"
            type="text"
            autocomplete="billing street-address"
            placeholder="Street address"
          />
        </label>

        <label class="control">
          <span>City</span>
          <input
            name="billingCity"
            type="text"
            autocomplete="billing address-level2"
          />
        </label>

        <label class="control">
          <span>State</span>
          <input
            name="billingState"
            type="text"
            autocomplete="billing address-level1"
            maxlength="2"
            placeholder="IL"
          />
        </label>

        <label class="control">
          <span>ZIP code</span>
          <input
            name="billingZip"
            type="text"
            inputmode="numeric"
            autocomplete="billing postal-code"
            placeholder="60007"
          />
        </label>
      </div>
    </fieldset>

    <div class="booking__submit">
      <button class="action" type="submit">
        {isReserve ? "Send reservation request" : "Request my quote"}
        <Icon name="arrow" size={16} />
      </button>
      <p class="booking__alt">
        Or call <a href={BUSINESS.phone.href}>{BUSINESS.phone.display}</a> — office
        {BUSINESS.hours.officeSummary}.
      </p>
    </div>
  </form>

  <!-- The receipt. Hidden until the request is submitted, then set the way a
       destination sign is set — the same object, and the same rule, as the
       homepage quote form. -->
  <div class="rb blade" hidden data-route-blade aria-live="polite">
    <div class="rb__strip">
      <span class="rb__coord mono">{BUSINESS.address.gridCoordinate}</span>
      <span class="rb__service mono"
        >{isReserve ? "Reservation requested" : "Quote requested"}</span
      >
    </div>

    <p class="rb__route gothic">
      <span data-blade-from>Pickup</span>
      <Icon name="arrow" size={26} class="rb__arrow" />
      <span data-blade-to>Destination</span>
    </p>

    <!-- Lower panel, read as keyed cells the way a sign's secondary panel is. -->
    <div class="rb__meta">
      <div class="rb__cell">
        <span class="rb__key mono">Passengers</span>
        <span class="rb__count mono" data-blade-count>—</span>
      </div>
      <div class="rb__cell">
        <span class="rb__key mono">Departs</span>
        <span class="rb__when mono" data-blade-when>—</span>
      </div>
      <div class="rb__cell">
        <span class="rb__key mono">Vehicle</span>
        <span class="rb__roll">
          <span class="rb__vehicle" data-blade-vehicle
            >Awaiting passenger count</span
          >
        </span>
        <span class="rb__detail" data-blade-detail></span>
      </div>
    </div>

    <p class="rb__status">
      <span data-blade-status></span>
      <a class="rb__call" href={BUSINESS.phone.href} data-blade-call hidden>
        <Icon name="phone" size={15} />
        {BUSINESS.phone.display}
      </a>
    </p>
  </div>
</div>

<style>
  .booking {
    display: grid;
    gap: var(--space-8);
  }

  /* ---- The receipt blade ---- */

  /* .blade sets display:block, which would otherwise beat the UA [hidden] rule. */
  .rb[hidden] {
    display: none;
  }

  .rb {
    padding: var(--space-6) var(--space-8);
    transform-origin: top center;
  }

  /* Set the way a blade is set into its bracket: down and square, no bounce. */
  .rb[data-shown] {
    animation: rbset 460ms var(--ease-out);
  }

  @keyframes rbset {
    0% {
      opacity: 0;
      transform: translateY(-14px) scaleY(0.9);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .rb__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--blade-divider);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .rb__coord {
    color: var(--azure);
  }

  .rb__service {
    color: var(--signal-dim);
  }

  .rb__route {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
    font-size: clamp(1.25rem, 3.2vw, 2.125rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.005em;
  }

  .rb__route span {
    transition: color 200ms var(--ease-out);
  }

  /* Unset slots read as empty without dropping below the contrast floor. */
  .rb__route span:not([data-set]) {
    color: var(--signal-unset);
  }

  .rb__arrow {
    flex: none;
    color: var(--hivis);
  }

  .rb__meta {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--blade-divider);
    font-size: 0.875rem;
  }

  .rb__cell {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .rb__cell + .rb__cell {
    padding-left: var(--space-6);
    border-left: 1px solid var(--blade-divider);
  }

  .rb__key {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azure);
  }

  .rb__count {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--signal);
  }

  .rb__when {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--signal);
  }

  /* The roll window: the vehicle line changes the way a destination blind
     changes — it rolls through, it does not cross-fade. */
  /* No fixed height — the child is clipped by this box while it rolls in, so
     the vehicle name is free to wrap on a narrow screen. */
  .rb__roll {
    display: block;
    overflow: hidden;
  }

  .rb__vehicle {
    display: block;
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--hivis);
  }

  .rb__vehicle[data-rolling] {
    animation: roll 420ms var(--ease-out);
  }

  @keyframes roll {
    0% {
      transform: translateY(-105%);
      filter: blur(2.5px);
      opacity: 0.4;
    }
    100% {
      transform: translateY(0);
      filter: blur(0);
      opacity: 1;
    }
  }

  .rb__detail {
    display: block;
    color: var(--signal-dim);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .rb__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--blade-divider);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--signal-dim);
  }

  /* Anything the visitor has to act on takes high-vis, same as everywhere. */
  .rb__status[data-tone="act"] {
    color: var(--hivis);
    font-weight: 700;
  }

  .rb__call {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--hivis);
    white-space: nowrap;
  }

  .rb__call[hidden] {
    display: none;
  }

  @media (max-width: 46rem) {
    .rb {
      padding: var(--space-5) var(--space-6);
    }

    .rb__meta {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .rb__cell + .rb__cell {
      padding-left: 0;
      padding-top: var(--space-4);
      border-left: 0;
      border-top: 1px solid var(--blade-divider);
    }
  }

  /* ---- The form ---- */

  .booking__form {
    display: grid;
    gap: var(--space-8);
  }

  .booking__set {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .booking__set + .booking__set {
    padding-top: var(--space-8);
    border-top: 1px solid var(--paper-line);
  }

  .booking__set legend {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .booking__set .control {
    min-width: 0;
  }

  .booking__set .control :is(input, select) {
    min-width: 0;
    min-height: 3.25rem;
  }

  .booking__set .control textarea {
    min-height: 8.5rem;
  }

  /* The day count is a question only for the out-of-state answer, so it is not
     in the layout until that answer is picked. `:has` reads the live selection,
     which means the field appears without the script having to run. */
  .control--days {
    display: none;
  }

  .grid:has(option[data-out-of-state]:checked) .control--days {
    display: flex;
  }

  /* Six tracks, so a row of three short fields and a row of two long ones both
     come out flush. The same system runs in QuickQuote; the breakpoints differ
     because this form sits in the narrower of two columns on /quote. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .grid > * {
      grid-column: span 3;
    }

    .grid > .pair {
      grid-column: span 3;
    }

    .grid > .half,
    .grid > .full {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 72rem) {
    .grid > * {
      grid-column: span 2;
    }

    .grid > .half {
      grid-column: span 3;
    }

    .grid > .pair {
      grid-column: span 3;
    }

    .grid > .full {
      grid-column: 1 / -1;
    }
  }

  .booking__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-2) var(--space-1) 0;
  }

  .booking__alt {
    font-size: 0.9375rem;
    color: var(--ink-dim);
  }

  .booking__alt a {
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 39.999rem) {
    .booking__form {
      gap: var(--space-8);
    }

    .booking__set + .booking__set {
      padding-top: var(--space-6);
    }

    .booking__set legend {
      padding: 0;
      font-size: 0.6875rem;
    }

    .grid {
      gap: var(--space-4);
    }

    .booking__set .control > span {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }

    .booking__set .control :is(input, select, textarea) {
      padding-inline: var(--space-3);
    }

    .booking__submit {
      display: grid;
      gap: var(--space-3);
      width: 100%;
      padding-inline: 0;
    }

    .booking__submit .action {
      justify-content: center;
      width: 100%;
      min-height: 3.5rem;
      padding-inline: var(--space-4);
      text-align: center;
    }

    .booking__alt {
      text-align: center;
    }
  }
</style>

<script>
  import { recommendVehicle } from "../data/fleet";

  const blade = document.querySelector<HTMLElement>("[data-route-blade]");
  const form = document.querySelector<HTMLFormElement>("[data-booking]");
  if (blade && form) {
    const out = {
      from: blade.querySelector<HTMLElement>("[data-blade-from]")!,
      to: blade.querySelector<HTMLElement>("[data-blade-to]")!,
      count: blade.querySelector<HTMLElement>("[data-blade-count]")!,
      when: blade.querySelector<HTMLElement>("[data-blade-when]")!,
      vehicle: blade.querySelector<HTMLElement>("[data-blade-vehicle]")!,
      detail: blade.querySelector<HTMLElement>("[data-blade-detail]")!,
      status: blade.querySelector<HTMLElement>("[data-blade-status]")!,
      call: blade.querySelector<HTMLElement>("[data-blade-call]")!,
    };
    const statusLine = out.status.parentElement!;

    const field = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLSelectElement>(
        `[data-field="${name}"]`,
      );
    const named = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | null;

    const setSlot = (el: HTMLElement, value: string, fallback: string) => {
      const filled = value.trim().length > 0;
      el.textContent = filled ? value.trim() : fallback;
      el.toggleAttribute("data-set", filled);
    };

    const MONTHS = [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ];

    /**
     * Format the departure without constructing a Date: `yyyy-mm-dd` parses as
     * UTC, which renders the day before in Chicago.
     */
    const departure = (date: string, time: string) => {
      const [y, m, d] = date.split("-").map(Number);
      if (!y || !m || !d || !MONTHS[m - 1]) return "—";
      let text = `${d} ${MONTHS[m - 1]} ${y}`;
      const [hh, mm] = time.split(":").map(Number);
      if (Number.isFinite(hh) && Number.isFinite(mm)) {
        text += ` · ${hh % 12 === 0 ? 12 : hh % 12}:${String(mm).padStart(2, "0")} ${hh >= 12 ? "pm" : "am"}`;
      }
      return text;
    };

    /** `withCall` reveals the phone link, for the states where calling is the fix. */
    const setStatus = (
      text: string,
      tone: "act" | "plain",
      withCall = false,
    ) => {
      out.status.textContent = text;
      statusLine.setAttribute("data-tone", tone);
      out.call.hidden = !withCall;
    };

    let lastVehicle = "";

    const update = () => {
      setSlot(out.from, field("from")?.value ?? "", "Pickup");
      setSlot(out.to, field("to")?.value ?? "", "Destination");

      // Print the option's own band, so "50–57+" reads back as the one chosen
      // rather than as the 50 that names the vehicle.
      const raw = field("count")?.value ?? "";
      const count = Number.parseInt(raw, 10);
      out.count.textContent = Number.isFinite(count) && count > 0 ? raw : "—";
      out.when.textContent = departure(
        named("date")?.value ?? "",
        named("time")?.value ?? "",
      );

      const { name, detail } = recommendVehicle(count);

      // The detail is a function of the headcount, not only of the vehicle: two
      // counts inside one vehicle's range can read differently. It updates every
      // time. Only the name gates the roll, because re-rolling a line that has
      // not changed is motion for its own sake.
      out.detail.textContent = detail;

      if (name !== lastVehicle) {
        out.vehicle.textContent = name;
        // Restart the roll animation.
        out.vehicle.removeAttribute("data-rolling");
        void out.vehicle.offsetWidth;
        out.vehicle.setAttribute("data-rolling", "");
        lastVehicle = name;
      }
    };

    /**
     * The day count is revealed in CSS, but a stale value is not something CSS
     * can clear. A field hidden again after being filled must not submit the
     * number underneath it, so the answer is cleared on the way out.
     */
    const hours = form.elements.namedItem("hours") as HTMLSelectElement | null;
    const days = named("days");
    const syncDays = () => {
      if (!hours || !days) return;
      const outOfState =
        hours.selectedOptions[0]?.hasAttribute("data-out-of-state") ?? false;
      if (!outOfState) days.value = "";
    };
    syncDays();
    form.addEventListener("change", syncDays);

    /**
     * Prefill from a planning handoff such as the wedding package form.
     * Whatever the visitor already typed arrives in the query string and must
     * never be asked for a second time. The resulting URL is also shareable, so
     * this runs for anyone arriving on one.
     */
    const params = new URLSearchParams(window.location.search);
    if ([...params.keys()].length > 0) {
      for (const [key, value] of params) {
        if (!value.trim()) continue;
        const el = form.elements.namedItem(key);
        if (
          el instanceof HTMLInputElement ||
          el instanceof HTMLSelectElement ||
          el instanceof HTMLTextAreaElement
        ) {
          el.value = value;
        }
      }
      // A prefilled `hours` sets no change event, so the day count is squared
      // away here — before the hunt below decides what is still unanswered.
      syncDays();
      /*
       * Send them to the first thing still unanswered rather than the top. This
       * used to hunt `[required]`, which now matches the email field alone —
       * with the form asking rather than demanding, "unanswered" has to be read
       * off the fields themselves. The honeypot is skipped by its tabindex and
       * the form-name carrier by being hidden; neither is a question.
       */
      const firstEmpty = [
        ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input:not([type="hidden"]):not([tabindex="-1"]), select, textarea',
        ),
      ].find((el) => !el.value.trim() && el.offsetParent !== null);
      firstEmpty?.focus({ preventScroll: true });
    }

    let sent = false;

    form.addEventListener("submit", (event) => {
      // The submit event only fires once the browser's own validation passes.
      event.preventDefault();
      update();

      const firstReveal = blade.hidden;
      blade.hidden = false;
      blade.setAttribute("data-shown", "");
      sent = true;

      const body = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        if (typeof value === "string") body.append(key, value);
      }

      setStatus("Sending…", "plain");
      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      })
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          setStatus(
            "Successfully submitted. We reply during office hours.",
            "plain",
          );
        })
        .catch(() =>
          setStatus("That did not send. Reach us directly:", "act", true),
        );

      if (firstReveal) {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        blade.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: "center",
        });
      }
    });

    // Once the blade is up it tracks the fields, so it is never left stale.
    const onEdit = () => {
      if (blade.hidden) return;
      update();
      if (sent) {
        setStatus(
          "Details changed. Send the request again to update it.",
          "act",
        );
        sent = false;
      }
    };

    form.addEventListener("input", onEdit);
    form.addEventListener("change", onEdit);
  }
</script>
