---
import type { Placeholder } from '../lib/placeholder';

/**
 * Renders an unresolved item so it can never be mistaken for finished content.
 * Marked in high-vis because that is what high-vis is for: the thing that is
 * not yet safe to walk past.
 */
interface Props {
  item: Placeholder;
  /** Reserve visual space matching the eventual content. */
  ratio?: string;
}

const { item, ratio } = Astro.props;
---

<div class="ph" data-placeholder={item.id} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <p class="ph__kind mono">Awaiting {item.kind}</p>
  <p class="ph__label">{item.label}</p>
  <p class="ph__needed">{item.needed}</p>
</div>

<style>
  /* width and min-width are load-bearing: with `aspect-ratio` set and an
     auto-sized track, the box would otherwise derive its WIDTH from its content
     height and blow the page out sideways. */
  .ph {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
    padding: var(--space-6);
    border: 2px dashed var(--hivis-deep);
    border-radius: var(--radius);
    background: repeating-linear-gradient(
      -45deg,
      rgb(255 177 0 / 0.09) 0 12px,
      transparent 12px 24px
    );
    color: var(--ink);
  }

  .ph__kind {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hivis-text);
  }

  .ph__label {
    margin: 0;
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .ph__needed {
    margin: 0;
    max-width: min(46ch, 100%);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-dim);
  }
</style>
