---
import { Image } from 'astro:assets';
import { BUSINESS, NAV } from '../config/site';
import logo from '../assets/images/logo.png';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="masthead field">
  <div class="shell masthead__inner">
    <!-- The logo's navy wordmark measures 1.35:1 against the enamel ground, so
         it rides on a signal-white panel rather than being knocked out to white
         — which keeps the mark's blue-to-green gradient intact, and is how an
         enamel sign carries a plate anyway. -->
    <a class="mark" href="/">
      <span class="mark__plate">
        <Image src={logo} alt="Chicago Super Coach" loading="eager" densities={[1, 2]} />
      </span>
    </a>

    <!-- A checkbox so the menu still opens with JavaScript unavailable; the
         script below only adds the state announcement. -->
    <input
      type="checkbox"
      id="nav-toggle"
      class="sr-only nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
    />
    <!-- The icons are wrapped in spans that belong to this template, so the
         scoped show/hide rules reliably apply to them. -->
    <label class="nav-button" for="nav-toggle">
      <span class="nav-button__open"><Icon name="menu" size={22} /></span>
      <span class="nav-button__close"><Icon name="close" size={22} /></span>
      <span class="sr-only">Menu</span>
    </label>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul class="nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link gothic"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__actions">
        <a class="nav__phone mono" href={BUSINESS.phone.href}>
          <Icon name="phone" size={16} />
          {BUSINESS.phone.display}
        </a>
        <a class="action" href="/reserve">
          Reserve now
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 5rem;
    padding-block: var(--space-3);
  }

  /* Sign assembly: the maker's plate, alone. The grid coordinate that used to
     sit beside it is still set in the hero and the footer.
     The plate runs the full depth of the band rather than floating inside it —
     a fabricated panel bolted across the sign, not a card resting on one. It is
     the only element allowed to cancel the masthead's own padding: `stretch`
     takes it to the flex line, and the negative block margin takes it the rest
     of the way through the padding to both edges. */
  .mark {
    align-self: stretch;
    margin-block: calc(var(--space-3) * -1);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
    color: var(--signal);
  }

  .mark__plate {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding-inline: var(--space-5);
    background: var(--paper);
    /* Square, because a radius on a panel that meets both edges can only show
       on the corners that are left — which reads as a mistake, not a detail. */
    border-radius: 0;
  }

  .mark__plate :global(img) {
    display: block;
    width: auto;
    /* Sized so the plate fills the band at its existing height: 4rem of mark
       plus the padding this rule just cancelled comes back to the same 88px. */
    height: 4rem;
  }

  @media (max-width: 30rem) {
    .mark__plate :global(img) {
      height: 3rem;
    }

    .mark__plate {
      padding-inline: var(--space-4);
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: block;
    padding-block: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--signal);
    opacity: 0.82;
    transition: opacity 160ms var(--ease-out);
  }

  .nav__link:hover {
    opacity: 1;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--hivis);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__link[aria-current='page'] {
    opacity: 1;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--signal);
    white-space: nowrap;
  }

  .nav__phone:hover {
    color: var(--hivis);
  }

  /* The masthead's width budget.
     A fifth nav item put the bar over its limit at 1024: the action wrapped to
     two lines and the whole band grew by 25px. Three rules keep it on one line
     without moving the drawer breakpoint up onto laptop widths.

     1. The action never wraps. A call to action broken across two lines is not
        a button, it is a paragraph with a background.
     2. Between the drawer and 72rem the gaps close up.
     3. In that same band the phone number stands down. It is the one item here
        that is repeated verbatim in the footer of every page and in the drawer
        below 60rem, so it is the only thing that can leave without taking a
        route with it. It comes back the moment there is room. */
  .nav__actions .action {
    white-space: nowrap;
  }

  @media (min-width: 60.0625rem) and (max-width: 72rem) {
    .masthead__inner {
      gap: var(--space-4);
    }

    .nav {
      gap: var(--space-5);
    }

    .nav__list {
      gap: var(--space-4);
    }

    .nav__phone {
      display: none;
    }
  }

  .nav-button {
    display: none;
  }

  @media (max-width: 60rem) {
    .nav-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid rgb(255 255 255 / 0.35);
      border-radius: var(--radius);
      color: var(--signal);
      cursor: pointer;
    }

    .nav-button__open,
    .nav-button__close {
      display: flex;
    }

    .nav-button__close {
      display: none;
    }

    .nav-toggle:checked ~ .nav-button .nav-button__open {
      display: none;
    }

    .nav-toggle:checked ~ .nav-button .nav-button__close {
      display: flex;
    }

    .nav-toggle:focus-visible ~ .nav-button {
      outline: 3px solid var(--hivis);
      outline-offset: 3px;
    }

    /* The drawer covers the rest of the viewport. A panel that stops mid-screen
       lets the page's own CTA show through beneath the drawer's — two identical
       buttons a thumb apart. */
    .nav {
      position: absolute;
      inset: 100% 0 auto;
      height: calc(100dvh - 100%);
      overflow-y: auto;
      overscroll-behavior: contain;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-6) max(1.25rem, calc((100vw - var(--shell)) / 2))
        var(--space-16);
      background: var(--enamel-deep);
      background-image: var(--enamel-pattern);
      display: none;
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--enamel-line);
      font-size: 1rem;
    }

    .nav__actions {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding-top: var(--space-2);
    }

    .nav__phone {
      justify-content: center;
      padding-block: var(--space-3);
    }

    .nav__actions .action {
      justify-content: center;
    }
  }
</style>

<script>
  // The checkbox carries the open state; this only announces it.
  const toggle = document.getElementById("nav-toggle") as HTMLInputElement | null;
  toggle?.addEventListener("change", () => {
    toggle.setAttribute("aria-expanded", String(toggle.checked));
  });
</script>
