---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageTitle from './PageTitle.astro';
import PageHero from './PageHero.astro';
import GuideBody from './GuideBody.astro';
import LinkedText from './LinkedText.astro';
import Icon from './Icon.astro';
import LandingQuote from './LandingQuote.astro';
import LandingFleet from './LandingFleet.astro';
import CloseBand from './CloseBand.astro';
import type { TransportationPage } from '../data/transportationPages';
import { BUSINESS, SITE_ORIGIN } from '../config/site';

interface Props { page: TransportationPage }
const { page } = Astro.props;
const directory = page.kind === 'location'
  ? { label: 'Service areas', href: '/service-areas' }
  : { label: 'Transportation services', href: '/services' };
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: page.name, description: page.meta.description,
    url: new URL(page.path, SITE_ORIGIN).href,
    provider: { '@id': `${SITE_ORIGIN}/#business` },
    areaServed: { '@type': 'Place', name: page.area },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', href: '/' }, directory,
      { name: page.name, href: page.path },
    ].map((item, i) => ({
      '@type': 'ListItem', position: i + 1,
      name: 'name' in item ? item.name : item.label,
      item: new URL(item.href, SITE_ORIGIN).href,
    })),
  },
];
---

<Layout path={page.path} title={page.meta.title} description={page.meta.description} bookingHref="#quote-form"
  ogImage={page.image.src.src} ogImageAlt={page.image.alt} jsonLd={schema}>
  <PageHero>
    <nav class="transport__breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href={directory.href}>{directory.label}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{page.name}</span>
    </nav>
    <PageTitle title={page.heading} scale="hero" />
    <p class="lede transport__lede"><LinkedText text={page.intro.text} links={page.intro.links} quoteHref="#quote-form" /></p>
    <div class="transport__actions" slot="actions">
      <a class="action" href="#quote-form">Get a Trip Quote <Icon name="arrow" size={18} /></a>
      <a class="direction" href={BUSINESS.phone.href}>Call {BUSINESS.phone.display}</a>
    </div>
    <figure slot="media">
      <Image src={page.image.src} alt={page.image.alt} widths={[480, 800, 1200]}
        sizes="(min-width: 60rem) 46vw, 92vw" loading="eager"
        style={{ objectPosition: page.image.position ?? 'center' }} />
      <figcaption>{page.image.caption}</figcaption>
    </figure>
  </PageHero>
  <LandingQuote context={page.name} />
  <section class="section--tight transport">
    <div class="shell">
      <div class="transport__body">
        <div class="transport__article"><GuideBody blocks={page.blocks} quoteHref="#quote-form" /></div>
        <aside class="transport__aside" aria-label="Trip planning">
          <div class="plate transport__checklist">
            <h2 class="subtitle">Have these details ready</h2>
            <ul>{page.checklist.map((item) => <li><Icon name="check" size={17} /><span>{item}</span></li>)}</ul>
            <a class="direction" href="#quote-form">Plan Your Trip <Icon name="arrow" size={18} /></a>
          </div>
          <nav class="transport__related" aria-label="Related transportation">
            <h2 class="subtitle">Connect your trip</h2>
            <ul>{page.related.map((item) => <li><a href={item.href === '/#quote-form' ? '#quote-form' : item.href}>{item.label}<Icon name="arrow" size={16} /></a></li>)}</ul>
          </nav>
        </aside>
      </div>
    </div>
  </section>
  <LandingFleet />
  <CloseBand heading="Ready to plan your trip?" description="Send your dates, route, and passenger count. Our reservation team will help you confirm the details."
    primaryAction={{ label: 'Get My Trip Quote', href: '#quote-form' }} secondaryAction={{ label: `Call ${BUSINESS.phone.display}`, href: BUSINESS.phone.href }} />
</Layout>

<style>
  .transport__breadcrumb { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-bottom: var(--space-5); font-size: .8125rem; color: var(--ink-dim); }
  .transport__breadcrumb a { text-underline-offset: 3px; }
  .transport__body { display: grid; gap: var(--space-8); }
  .transport__lede { margin-top: var(--space-6); max-width: 54ch; }
  .transport__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); }
  .transport__body { align-items: start; }
  .transport__article, .transport__aside { min-width: 0; }
  .transport__checklist h2, .transport__related h2 { font-size: 1.375rem; }
  .transport__checklist ul, .transport__related ul { list-style: none; padding: 0; margin: var(--space-5) 0; }
  .transport__checklist li { display: flex; gap: var(--space-3); margin-top: var(--space-4); font-size: .9375rem; }
  .transport__checklist :global(svg) { flex-shrink: 0; margin-top: 3px; }
  .transport__related { margin-top: var(--space-8); }
  .transport__related a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding-block: var(--space-4); border-bottom: 1px solid var(--paper-line); text-underline-offset: 4px; }
  .transport__related :global(svg) { flex-shrink: 0; }
  @media (min-width: 60rem) {
    .transport__body { grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-12); }
  }
</style>
