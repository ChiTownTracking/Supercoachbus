---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import chicagoRiver from '../assets/images/why-choose-us/chicago-river-pexels.jpg';
import chicagoTheatre from '../assets/images/why-choose-us/chicago-theatre-pexels.jpg';

const features = [
  {
    icon: 'check',
    title: 'Keep Your Group Together',
    description:
      'Travel together without coordinating separate cars or rideshares. Larger groups can arrange multiple buses.',
  },
  {
    icon: 'pin',
    title: 'Avoid Chicago Parking Hassles',
    description:
      'Travel to events and destinations without everyone searching for parking.',
  },
  {
    icon: 'seat',
    title: 'Travel Comfortably',
    description:
      'Our coaches offer reclining seats and climate control. Ask us to confirm any additional amenities for your trip.',
  },
  {
    icon: 'clock',
    title: 'Simplify Group Travel',
    description:
      'One transportation plan makes it easier to coordinate pickups, destinations, schedules, and return trips.',
  },
] as const;
---

<section class="section why" id="why-choose-us" aria-labelledby="why-heading">
  <div class="shell why__layout">
    <div class="why__intro">
      <p class="coordinate coordinate--ink">Why Choose Us</p>
      <h2 class="title why__heading" id="why-heading">Why Rent a Charter Bus in Chicago?</h2>
      <p class="lede why__lede">
        Coordinating transportation for a large group in Chicago can be
        challenging. A private charter brings your trip under one transportation
        plan, with professional drivers and vehicles matched to your group size.
      </p>
    </div>

    <div class="why__photos">
      <figure class="why__photo why__photo--river">
        <Image
          src={chicagoRiver}
          alt="The Chicago River winding between downtown skyscrapers beneath a blue sky"
          widths={[400, 640, 960, 1400]}
          sizes="(min-width: 83rem) 30rem, (min-width: 64rem) 38vw, 60vw"
          loading="lazy"
        />
      </figure>
      <figure class="why__photo why__photo--theatre">
        <Image
          src={chicagoTheatre}
          alt="The Chicago Theatre's illuminated marquee and historic facade on State Street"
          widths={[320, 480, 720, 1000]}
          sizes="(min-width: 83rem) 30rem, (min-width: 64rem) 38vw, 32vw"
          loading="lazy"
        />
      </figure>
    </div>

    <ul class="why__features">
      {
        features.map((feature) => (
          <li class="why__feature">
            <span class="why__icon"><Icon name={feature.icon} size={24} /></span>
            <h3 class="why__feature-title">{feature.title}</h3>
            <p class="why__description">{feature.description}</p>
          </li>
        ))
      }
    </ul>

    <a class="action why__cta" href="/about">
      About Us
      <Icon name="arrow" size={18} />
    </a>
  </div>
</section>

<style>
  .why {
    border-bottom: 1px solid var(--paper-line);
  }

  .why__layout {
    display: grid;
    gap: var(--space-8);
  }

  .why__heading {
    max-width: 22ch;
    color: var(--enamel-ink);
  }

  .why__lede {
    margin-top: var(--space-5);
    max-width: 58ch;
  }

  .why__photos {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-3);
    aspect-ratio: 1.8;
    min-width: 0;
  }

  .why__photo {
    position: relative;
    min-width: 0;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--enamel-deep);
  }

  .why__photo::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--keyline);
    border-radius: 1px;
    pointer-events: none;
  }

  .why__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why__photo--theatre :global(img) {
    object-position: 35% center;
  }

  .why__features {
    display: grid;
    gap: var(--space-6) var(--space-8);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .why__feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--paper-line);
  }

  .why__icon {
    color: var(--enamel-ink);
    grid-row: span 2;
  }

  .why__feature-title {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--enamel-ink);
  }

  .why__description {
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.6;
  }

  .why__cta {
    justify-self: start;
    align-self: start;
  }

  @media (min-width: 40rem) {
    .why__photos {
      aspect-ratio: 2.4;
    }

    .why__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .why__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-rows: auto 1fr auto;
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .why__intro,
    .why__features,
    .why__cta {
      grid-column: 2;
    }

    .why__photos {
      grid-column: 1;
      grid-row: 1 / 4;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1.3fr 1fr;
      gap: var(--space-4);
      aspect-ratio: auto;
    }

    .why__feature {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .why__icon {
      grid-row: auto;
    }
  }
</style>
