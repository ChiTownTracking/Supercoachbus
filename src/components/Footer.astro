---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { BUSINESS, FOOTER_NAV, LEGAL_NAV } from '../config/site';
import { SERVICES } from '../data/services';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const { address, hours, phone } = BUSINESS;
---

<footer class="foot field field--deep">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__mark">
        <span class="foot__plate">
          <Image src={logo} alt="Chicago Super Coach" loading="lazy" densities={[1, 2]} />
        </span>
        <p class="foot__line">
          Charter and shuttle bus rental with professional drivers, serving {
            BUSINESS.serviceArea
          }.
        </p>
        <a class="action" href="/#quote-form">
          Get a quote
          <Icon name="arrow" size={16} />
        </a>
      </div>

      <div class="foot__cols">
        <section class="foot__col">
          <h2 class="foot__head mono">Contact</h2>
          <ul class="foot__list">
            <li>
              <a href={phone.href}><Icon name="phone" size={15} />{phone.display}</a>
            </li>
            <li>
              <a href={`mailto:${BUSINESS.email}`}>
                <Icon name="mail" size={15} />{BUSINESS.email}
              </a>
            </li>
            <li>
              <a href={BUSINESS.googleMapsUrl} target="_blank" rel="noopener">
                <Icon name="pin" size={15} />
                <span>{address.street}<br />{address.city}, {address.region} {address.postalCode}</span>
              </a>
            </li>
            <li class="foot__hours">
              <Icon name="clock" size={15} />
              <span>
                Office {hours.officeDays}<br />
                {hours.officeTime}
                <em>{hours.charterNote}</em>
              </span>
            </li>
          </ul>
        </section>

        <nav class="foot__col" aria-label="Footer">
          <h2 class="foot__head mono">Site</h2>
          <ul class="foot__list">
            {FOOTER_NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          </ul>
        </nav>

        <nav class="foot__col" aria-label="Services">
          <h2 class="foot__head mono">Services</h2>
          <ul class="foot__list">
            {
              SERVICES.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`}>{s.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="foot__bottom">
      <p class="mono">© {year} {BUSINESS.name}. All rights reserved.</p>
      <ul class="foot__legal">
        {LEGAL_NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Hairline, not an amber rule: amber is the action colour and a decorative
     band of it on every page dilutes the one thing meant to be pressed. */
  .foot {
    border-top: 1px solid var(--enamel-line);
    padding-block: var(--space-16) var(--space-8);
  }

  .foot__top {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 60rem) {
    .foot__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
      gap: var(--space-16);
    }
  }

  .foot__plate {
    display: inline-block;
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background: var(--signal);
    border-radius: var(--radius);
  }

  .foot__plate :global(img) {
    display: block;
    width: auto;
    height: 3.5rem;
  }

  .foot__line {
    max-width: 34ch;
    margin-bottom: var(--space-6);
    color: var(--signal-dim);
    font-size: 0.9375rem;
  }

  .foot__cols {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .foot__head {
    margin: 0 0 var(--space-4);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azure);
  }

  .foot__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .foot__list a,
  .foot__hours {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--signal-dim);
    text-decoration: none;
    line-height: 1.45;
  }

  .foot__list a:hover {
    color: var(--signal);
  }

  .foot__list :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--enamel-line);
  }

  .foot__list a:hover :global(svg) {
    color: var(--hivis);
  }

  .foot__hours em {
    display: block;
    margin-top: var(--space-1);
    color: var(--hivis);
    font-style: normal;
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--enamel-line);
    font-size: 0.75rem;
    color: var(--signal-dim);
  }

  .foot__bottom p {
    letter-spacing: 0.04em;
  }

  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__legal a {
    color: var(--signal-dim);
    text-decoration: none;
  }

  .foot__legal a:hover {
    color: var(--signal);
  }
</style>
